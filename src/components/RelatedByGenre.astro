---
import { getCollection } from 'astro:content';
import { subgenresForPost } from '../utils/blog';
import BookCover from './BookCover.astro';

interface Props {
	/** Shelf subgenres of the current post (from subgenresForPost). */
	genres: string[];
	currentId: string;
	/** Current post's author — their books already appear in RelatedByAuthor. */
	author?: string;
	series?: string;
}

const { genres, currentId, author, series } = Astro.props;

const norm = (s: string) => s.replace(/\s+/g, ' ').trim().toLowerCase();
const wanted = new Set(genres.map(norm));

const candidates = await getCollection('blog', ({ data }) =>
	data.status === 'live' && data.postType !== 'list'
);

const related = candidates
	.filter((p) =>
		p.id !== currentId &&
		!(author && p.data.author && norm(p.data.author) === norm(author)) &&
		!(series && p.data.series === series) &&
		subgenresForPost(p).some((g) => wanted.has(norm(g)))
	)
	.sort((a, b) =>
		(b.data.rating ?? 0) - (a.data.rating ?? 0) ||
		b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
	)
	.slice(0, 6);

const primaryGenre = genres[0];
const tagSlug = primaryGenre ? primaryGenre.toLowerCase().replace(/\s+/g, '-') : '';

function shortTitle(full: string) {
	return full.replace(/\s*\([^)]+\)\s*$/, '').trim();
}
---

{related.length > 0 && primaryGenre && (
	<nav class="related-genre" aria-label={`More ${primaryGenre} reviews`}>
		<p class="related-genre-label">
			More in <a href={`/tags/${tagSlug}/`}><em>{primaryGenre}</em></a>
		</p>
		<ul class="related-genre-list">
			{related.map((p) => {
				const displayTitle = p.data.bookTitle || p.data.title;
				const short = shortTitle(displayTitle);
				return (
					<li class="related-genre-item">
						<a href={`/blog/${p.id}/`} aria-label={`Read my review of ${short}`}>
							<BookCover
								title={displayTitle}
								author={p.data.author}
								cover={p.data.heroImage}
								class="related-genre-cover"
							/>
						</a>
						<span class="related-genre-title">{short}</span>
					</li>
				);
			})}
		</ul>
	</nav>
)}

<style>
	.related-genre {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--rule);
	}

	.related-genre-label {
		font-family: var(--sans);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--muted);
		margin: 0 0 1.25rem;
	}

	.related-genre-label a {
		color: inherit;
		text-decoration: none;
	}

	.related-genre-label a:hover {
		color: var(--ink-2);
	}

	.related-genre-label em {
		font-style: normal;
	}

	.related-genre-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
	}

	.related-genre-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		width: 80px;
	}

	.related-genre-item :global(.related-genre-cover) {
		width: 80px;
		aspect-ratio: 2/3;
		border-radius: 2px;
	}

	.related-genre-item a {
		display: block;
		text-decoration: none;
		transition: opacity 0.15s;
	}

	.related-genre-item a:hover {
		opacity: 0.8;
	}

	.related-genre-title {
		font-family: var(--sans);
		font-size: 0.68rem;
		color: var(--ink-2);
		text-align: center;
		line-height: 1.3;
		max-width: 80px;
	}
</style>
