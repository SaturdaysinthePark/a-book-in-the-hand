---
// Reusable newsletter signup. Three placements share one component:
//   variant="footer" — compact, site-wide in the footer
//   variant="post"   — a subscription card at the end of a review/list
//   variant="page"   — the hero form on /newsletter
// Posts to the same-origin Netlify Function (added later); degrades to a plain
// form submit with JS off. On success it fires the GA4 `newsletter_signup` event.
interface Props { variant?: 'footer' | 'post' | 'page'; }
const { variant = 'post' } = Astro.props;

const lede =
  variant === 'footer'
    ? 'Stay updated for latest reviews and recommendations'
    : "";
const heading = variant === 'page' ? 'Subscribe to stay updated with my reviews, lists and recommendations!' : 'Read a little more.';
---

<section class={`nl nl-${variant}`} data-source={variant}>
  {variant !== 'footer' && <p class="nl-eyebrow">§ The newsletter</p>}
  {variant !== 'footer' && <h2 class="nl-title">{heading}</h2>}
  <p class="nl-lede">{lede}</p>

  <form class="nl-form" action="/.netlify/functions/subscribe" method="post" novalidate>
    <div class="nl-field">
      <label class="sr-only" for={`nl-email-${variant}`}>Email address</label>
      <input id={`nl-email-${variant}`} type="email" name="email" required placeholder="you@email.com" autocomplete="email" spellcheck="false" />
    </div>
    {/* honeypot — bots fill it, humans never see it */}
    <input type="text" name="company" class="nl-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <button type="submit" class="nl-btn">Subscribe</button>
  </form>

  <p class="nl-note"></p>
  <p class="nl-status" role="status" aria-live="polite" hidden></p>
</section>

<style>
  .nl { --nl-max: 30rem; }

  .nl-eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 14px;
  }
  .nl-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(24px, 3vw, 34px);
    letter-spacing: -0.02em;
    line-height: 1.08;
    color: var(--ink);
    margin: 0 0 12px;
  }
  .nl-lede {
    font-family: var(--serif);
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 46ch;
    margin: 0 0 20px;
  }

  .nl-form { display: flex; gap: 10px; flex-wrap: wrap; max-width: var(--nl-max); }
  /* `display: flex` above outranks the UA [hidden] rule, so hiding on success
     needs an explicit reset — otherwise the form + "Sending…" button linger. */
  .nl-form[hidden] { display: none; }
  .nl-field { flex: 1 1 15rem; min-width: 0; }
  .nl-field input {
    width: 100%;
    font-family: var(--sans);
    font-size: 15px;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 0;
    padding: 13px 14px;
    transition: border-color 160ms;
  }
  .nl-field input::placeholder { color: var(--muted); opacity: 0.7; }
  .nl-field input:focus { outline: none; border-color: var(--accent); }
  .nl-field input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }

  .nl-btn {
    font-family: var(--sans);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--paper);
    background: var(--accent);
    border: 0;
    border-radius: 0;
    padding: 13px 24px;
    white-space: nowrap;
    transition: background-color 160ms;
  }
  .nl-btn:hover { background: var(--accent-2); }
  .nl-btn:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .nl-btn[disabled] { opacity: 0.55; cursor: default; }

  .nl-hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

  .nl-note {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin: 12px 0 0;
  }
  .nl-status {
    font-family: var(--serif);
    font-size: 16px;
    line-height: 1.4;
    margin: 14px 0 0;
    max-width: var(--nl-max);
  }
  .nl-status.is-ok  { color: var(--viz-secondary); }
  .nl-status.is-err { color: var(--accent-2); }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }

  /* ── post: a subscription card echoing the email's note panel ── */
  .nl-post, .nl-page {
    background: var(--bg-2);
    border: 1px solid var(--rule);
    padding: clamp(26px, 4vw, 40px);
  }
  .nl-post { margin: 8px 0; }

  /* ── page: same panel, roomier hero ── */
  .nl-page .nl-title { font-size: clamp(30px, 5vw, 48px); }
  .nl-page .nl-lede  { font-size: clamp(17px, 1.6vw, 20px); max-width: 50ch; }

  /* ── footer: one compact row on desktop, stacks on mobile ── */
  .nl-footer { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 22px; }
  .nl-footer .nl-lede {
    font-size: clamp(11px, 3.2vw, 14px);
    color: var(--ink-2);
    text-transform: none;
    letter-spacing: normal;
    white-space: nowrap;
    margin: 0;
    max-width: none;
    flex: 0 0 auto;
  }
  .nl-footer .nl-form { margin: 0; flex: 1 1 18rem; max-width: 26rem; gap: 8px; }
  .nl-footer .nl-field input { padding: 10px 12px; font-size: 14px; }
  .nl-footer .nl-btn { padding: 10px 18px; }
  .nl-footer .nl-note { display: none; }
  .nl-footer .nl-status { flex: 1 1 100%; margin: 8px 0 0; font-size: 14px; }

  @media (max-width: 520px) {
    .nl-form { flex-direction: column; align-items: stretch; }
    .nl-field { flex: 0 0 auto; }
    .nl-btn { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nl-field input, .nl-btn { transition: none; }
  }
</style>

<script>
  import { track } from '../utils/analytics';

  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  document.querySelectorAll<HTMLElement>('.nl').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('.nl-form');
    const input = root.querySelector<HTMLInputElement>('input[name="email"]');
    const hp = root.querySelector<HTMLInputElement>('input[name="company"]');
    const btn = root.querySelector<HTMLButtonElement>('.nl-btn');
    const status = root.querySelector<HTMLElement>('.nl-status');
    const source = root.dataset.source || 'unknown';
    if (!form || !input || !btn || !status) return;

    const say = (msg: string, kind: 'ok' | 'err') => {
      status.textContent = msg;
      status.hidden = false;
      status.classList.remove('is-ok', 'is-err');
      status.classList.add(kind === 'ok' ? 'is-ok' : 'is-err');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = input.value.trim();
      if (!EMAIL_RE.test(email)) { say("That email doesn't look right. Mind checking it?", 'err'); input.focus(); return; }
      if (hp && hp.value) return; // bot

      btn.disabled = true;
      const label = btn.textContent;
      btn.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, source, company: hp?.value || '' }),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.hidden = true;
        root.querySelector('.nl-note')?.setAttribute('hidden', '');
        say("You're on the list. Look out for a letter at the end of the month.", 'ok');
        track('newsletter_signup', { signup_source: source });
      } catch {
        btn.disabled = false;
        btn.textContent = label;
        say("That didn't go through. Try again in a moment.", 'err');
      }
    });
  });
</script>
