---
import { FOOTER } from '../consts';
const year = new Date().getFullYear();
---

<footer class="ftr">
	<div class="ftr-row">
		<span>© {FOOTER.owner} {year}</span>
		<a href={FOOTER.rssUrl}>RSS</a>
		<a href={FOOTER.goodreadsUrl} target="_blank" rel="noopener noreferrer">{FOOTER.goodreadsLabel}</a>
		<span class="ftr-colophon">{FOOTER.colophon}</span>
	</div>
</footer>
