---
import { getCollection } from 'astro:content';
import BookCover from './BookCover.astro';

interface Props {
	series: string;
	currentId: string;
}

const { series, currentId } = Astro.props;

const seriesPosts = (await getCollection('blog', ({ data }) =>
	data.status === 'live' && data.series === series
)).sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));

// Strip the series parenthetical: "Title (Series, #N)" → "Title"
function shortTitle(full: string) {
	return full.replace(/\s*\([^)]+\)\s*$/, '').trim();
}
---

{seriesPosts.length > 1 && (
	<nav class="series-nav" aria-label={`More in ${series}`}>
		<p class="series-nav-label">More in <em>{series}</em></p>
		<ul class="series-nav-list">
			{seriesPosts.map((p) => {
				const isCurrent = p.id === currentId;
				const displayTitle = p.data.bookTitle || p.data.title;
				const short = shortTitle(displayTitle);
				return (
					<li class:list={['series-nav-item', isCurrent && 'is-current']}>
						{isCurrent ? (
							<BookCover
								title={displayTitle}
								author={p.data.author}
								cover={p.data.heroImage}
								class="series-nav-cover"
							/>
						) : (
							<a href={`/blog/${p.id}/`} aria-label={`Read my review of ${short}`}>
								<BookCover
									title={displayTitle}
									author={p.data.author}
									cover={p.data.heroImage}
									class="series-nav-cover"
								/>
							</a>
						)}
						<span class="series-nav-title">{short}</span>
					</li>
				);
			})}
		</ul>
	</nav>
)}

<style>
	.series-nav {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--rule);
	}

	.series-nav-label {
		font-family: var(--sans);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--muted);
		margin: 0 0 1.25rem;
	}

	.series-nav-label em {
		font-style: normal;
	}

	.series-nav-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
	}

	.series-nav-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		width: 80px;
	}

	.series-nav-item :global(.series-nav-cover) {
		width: 80px;
		aspect-ratio: 2/3;
		border-radius: 2px;
	}

	.series-nav-item a {
		display: block;
		text-decoration: none;
		transition: opacity 0.15s;
	}

	.series-nav-item a:hover {
		opacity: 0.8;
	}

	.series-nav-item.is-current :global(.series-nav-cover) {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.series-nav-title {
		font-family: var(--sans);
		font-size: 0.68rem;
		color: var(--ink-2);
		text-align: center;
		line-height: 1.3;
		max-width: 80px;
	}

	.series-nav-item.is-current .series-nav-title {
		color: var(--accent);
		font-weight: 600;
	}
</style>
