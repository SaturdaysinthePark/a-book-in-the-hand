---
// Orchestrates the four-screen "peel" homepage. Renders every screen as real,
// crawlable, server-side content in normal flow (the accessible fallback), and —
// when JS + motion are available — enhances into the scroll-choreographed view.
import '../../styles/home.css';
import { FOOTER } from '../../consts';
import ScreenLatest from './ScreenLatest.astro';
import ScreenRecent from './ScreenRecent.astro';
import ScreenLists from './ScreenLists.astro';
import ScreenStats from './ScreenStats.astro';

interface Pick { title: string; author?: string | null; cover?: string | null; }
interface Book { title: string; author?: string | null; rating?: number | null; cover?: string | null; url?: string; }
interface Props {
	latest: { title: string; author?: string | null; rating?: number | null; date: Date; blurb?: string | null; cover?: string | null; url: string };
	current: { title: string; author?: string | null; cover?: string | null; coverBg?: string; coverInk?: string; progress?: string; url?: string } | null;
	featured: { title: string; blurb?: string | null; picks: Pick[]; count: number; date: Date; url: string } | null;
	recentRow1: Book[];
	recentRow2: Book[];
	cells: any[];
	stats: { uniqueBooks: number; uniqueAuthors: number; pagesRead: number };
	years: { label: number | string; value: number }[];
	urls: { allReviews: string; stats: string; shelf: string };
}
const { latest, current, featured, recentRow1, recentRow2, cells, stats, years, urls } = Astro.props;
const year = new Date().getFullYear();
---

{/* Enhancement gate — runs synchronously before the screens paint, so the fx
    layout applies from first paint (no flash of the stacked fallback). */}
<script is:inline>
	(function () {
		try {
			if (window.matchMedia && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
				document.documentElement.classList.add('fx-on');
			}
		} catch (e) {}
	})();
</script>

<div class="home-exp">
	<ScreenLatest latest={latest} current={current} featured={featured} />
	<ScreenRecent row1={recentRow1} row2={recentRow2} allReviewsUrl={urls.allReviews} />
	{cells.length > 0 && <ScreenLists cells={cells} />}
	<ScreenStats
		uniqueBooks={stats.uniqueBooks}
		uniqueAuthors={stats.uniqueAuthors}
		pagesRead={stats.pagesRead}
		years={years}
		statsUrl={urls.stats}
		shelfUrl={urls.shelf}
	/>
</div>

<footer class="hx-foot" aria-label="Site footer">
	<span>© {FOOTER.owner} {year}</span>
	<a href={FOOTER.rssUrl} aria-label="RSS Feed"><svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true" style="display:inline-block;vertical-align:middle;margin-right:4px;margin-top:-1px"><circle cx="2" cy="9" r="1.4" fill="currentColor"/><path d="M1.5 5.5a5 5 0 0 1 5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><path d="M1.5 1.5a9 9 0 0 1 9 9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>RSS</a>
	<a href={FOOTER.goodreadsUrl} target="_blank" rel="noopener noreferrer">+ {FOOTER.goodreadsLabel}</a>
	<span class="hx-foot__colophon">{FOOTER.colophon}</span>
</footer>

<div id="hx-section-ind" aria-hidden="true">01 — Latest Review</div>

<script>
	import { initHomeScroll } from '../../scripts/home-scroll';
	initHomeScroll();
</script>
