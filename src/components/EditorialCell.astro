---
// Tiered editorial block for /my-lists (design_handoff_lists_page 3A/3B).
// § watermark numeral + meta + italic title + blurb + read-link + a fixed-size cover row.
// Cover box size is fixed per tier — never derived from how many books are in the list.
import BookCover from './BookCover.astro';

interface Pick { title: string; author?: string | null; cover?: string | null; }
interface Props {
	href: string;
	title: string;
	blurb?: string | null;
	num?: string | null;
	tier: 'hero' | 'half' | 'band';
	color?: 'green' | 'rust' | 'brown' | 'paper2' | 'paper';
	picks?: Pick[];
	maxShown?: number;
	/** Covers visible at the mobile breakpoint, when narrower than `maxShown` — the
	 *  strip is capped so nothing bleeds past the viewport (design refinement, 3B). */
	mobileMaxShown?: number;
	meta?: string | null;
	class?: string;
}
const {
	href, title, blurb, num = null, tier, color = 'green',
	picks = [], maxShown = 5, mobileMaxShown, meta = null, class: className = '',
} = Astro.props;
const shown = picks.slice(0, maxShown);
// Band tier is a compact decorative row — no "+N" overflow tail, just as many as fit.
const overflow = tier === 'band' ? 0 : Math.max(picks.length - shown.length, 0);
const mobileShown = mobileMaxShown ?? maxShown;
const overflowMobile = tier === 'band' ? 0 : Math.max(picks.length - mobileShown, 0);
const hasMobileCap = mobileShown < maxShown;
---

<a
	href={href}
	class:list={['ed-cell', `ed-cell--${tier}`, `ed-cell--${color}`, 'mz-rise', className]}
>
	{num && <span class="wm-num" aria-hidden="true">{num}</span>}
	<div class="ed-cell__head">
		{meta && <p class="ed-cell__meta">{meta}</p>}
		<h2>{title}</h2>
		{blurb && <p class="ed-cell__blurb">{blurb}</p>}
		<span class="ed-cell__read">Read the list</span>
	</div>
	<div class="ed-cell__books">
		{shown.length > 0 && (
			<div class:list={['ed-cell__grid', hasMobileCap && 'ed-cell__grid--capped', hasMobileCap && `ed-cell__grid--capped-${mobileShown}`]}>
				{shown.map((p) => (
					<BookCover title={p.title} author={p.author} cover={p.cover} class="cover-fit-contain" alt="" loading="lazy" />
				))}
				{overflow > 0 && <span class="ed-cell__more ed-cell__more--full">+ {overflow}</span>}
				{hasMobileCap && overflowMobile > 0 && <span class="ed-cell__more ed-cell__more--mobile">+ {overflowMobile}</span>}
			</div>
		)}
	</div>
</a>
