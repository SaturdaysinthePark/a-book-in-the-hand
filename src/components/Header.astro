---
const pathname = Astro.url.pathname;
const isActive = (path: string) =>
	path === '/'
		? pathname === '/'
		: pathname.startsWith(path);
---

<header class="hdr" id="site-header">
	<div class="hdr-shell">
		<a href="/" class="bk-logo" aria-label="Saturdays in a Book — home">
			<span class="bk-mark" aria-hidden="true">§</span> Saturdays in a Book
		</a>

		<!-- Desktop nav -->
		<nav class="hdr-nav" aria-label="Site navigation">
			<a href="/book-reviews" class={isActive('/book-reviews') ? 'is-active' : ''}>Reviews</a>
			<a href="/my-lists"     class={isActive('/my-lists')     ? 'is-active' : ''}>Lists</a>
			<a href="/stats"        class={isActive('/stats')        ? 'is-active' : ''}>Stats</a>
			<a href="/about"        class={isActive('/about')        ? 'is-active' : ''}>About</a>
			<button class="hdr-search" id="search-btn" aria-label="Search">
				<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
					<circle cx="7" cy="7" r="4.5"/>
					<line x1="10.4" y1="10.4" x2="13.5" y2="13.5" stroke-linecap="round"/>
				</svg>
			</button>
		</nav>

		<!-- Mobile books icon (links to all reviews) -->
		<a href="/book-reviews" class:list={['hdr-search hdr-books-m', isActive('/book-reviews') ? 'is-active' : '']} aria-label="All reviews">
			<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
				<path d="M4 19V6a2 2 0 0 1 2-2h11a1 1 0 0 1 1 1v14"/>
				<path d="M4 19a1 1 0 0 0 1 1h13a1 1 0 0 0 1-1v-1H5a1 1 0 0 0-1 1z"/>
				<line x1="9" y1="4" x2="9" y2="20"/>
			</svg>
		</a>

		<!-- Mobile search (surfaced outside the hamburger for faster access) -->
		<button class="hdr-search hdr-search-m" id="search-btn-m" aria-label="Search">
			<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4">
				<circle cx="7" cy="7" r="4.5"/>
				<line x1="10.4" y1="10.4" x2="13.5" y2="13.5" stroke-linecap="round"/>
			</svg>
		</button>

		<!-- Mobile hamburger -->
		<button class="hdr-menu-btn" id="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-drawer">
			<span aria-hidden="true">
				<span class="ham-line"></span>
				<span class="ham-line"></span>
				<span class="ham-line"></span>
			</span>
		</button>
	</div>
</header>

<!-- Mobile drawer (full-screen overlay) -->
<div class="hdr-drawer" id="mobile-drawer" role="dialog" aria-modal="true" aria-label="Navigation" aria-hidden="true">
	<nav class="hdr-drawer-links">
		<a href="/book-reviews" class={isActive('/book-reviews') ? 'is-active' : ''}>Reviews</a>
		<a href="/my-lists"     class={isActive('/my-lists')     ? 'is-active' : ''}>Lists</a>
		<a href="/stats"        class={isActive('/stats')        ? 'is-active' : ''}>Stats</a>
		<a href="/about"        class={isActive('/about')        ? 'is-active' : ''}>About</a>
		<a href="#" id="drawer-search">Search</a>
	</nav>
</div>

<!-- Search overlay -->
<div class="search-overlay" id="search-overlay" style="display:none" role="dialog" aria-modal="true" aria-label="Search">
	<div class="search-modal">
		<div class="search-input-wrap">
			<svg width="17" height="17" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
				<circle cx="7" cy="7" r="4.5"/>
				<line x1="10.4" y1="10.4" x2="13.5" y2="13.5" stroke-linecap="round"/>
			</svg>
			<input id="search-input" class="search-input" type="text" placeholder="Search reviews, books, authors, genres…" autocomplete="off" spellcheck="false" role="combobox" aria-expanded="false" aria-controls="search-results" aria-autocomplete="list" />
			<button class="search-esc-hint" id="search-close" aria-label="Close search">esc</button>
		</div>
		<div class="search-results" id="search-results" role="listbox" aria-label="Search results"></div>
	</div>
</div>

<script>
import Fuse from 'fuse.js';
import type { SearchEntry, SearchIndex } from '../utils/search';
import { track } from '../utils/analytics';

document.addEventListener('DOMContentLoaded', () => {
	const header    = document.getElementById('site-header')!;
	const menuBtn   = document.getElementById('menu-btn')!;
	const drawer    = document.getElementById('mobile-drawer')!;
	const searchBtn = document.getElementById('search-btn')!;
	const drawerSearch = document.getElementById('drawer-search');
	const overlay   = document.getElementById('search-overlay')!;
	const searchClose = document.getElementById('search-close')!;
	const searchInput = document.getElementById('search-input') as HTMLInputElement;
	const resultsEl = document.getElementById('search-results')!;

	// Scroll-aware sticky header
	window.addEventListener('scroll', () => {
		header.classList.toggle('is-scrolled', window.scrollY > 8);
	}, { passive: true });

	// Mobile menu toggle
	let menuOpen = false;
	function openMenu() {
		menuOpen = true;
		header.classList.add('menu-open');
		drawer.classList.add('is-open');
		drawer.setAttribute('aria-hidden', 'false');
		menuBtn.setAttribute('aria-label', 'Close menu');
		menuBtn.setAttribute('aria-expanded', 'true');
		document.body.style.overflow = 'hidden';
	}
	function closeMenu() {
		menuOpen = false;
		header.classList.remove('menu-open');
		drawer.classList.remove('is-open');
		drawer.setAttribute('aria-hidden', 'true');
		menuBtn.setAttribute('aria-label', 'Open menu');
		menuBtn.setAttribute('aria-expanded', 'false');
		document.body.style.overflow = '';
	}
	menuBtn.addEventListener('click', () => menuOpen ? closeMenu() : openMenu());

	// Close drawer on link click
	drawer.querySelectorAll('a:not(#drawer-search)').forEach(link => {
		link.addEventListener('click', closeMenu);
	});

	// ── Search ────────────────────────────────────────────────────────────
	let fuse: Fuse<SearchEntry> | null = null;
	let suggestions: SearchIndex['suggestions'] | null = null;
	let loaded = false;
	let activeIdx = -1; // index into the navigable (clickable) rows

	const TYPE_LABEL: Record<SearchEntry['type'], string> = {
		review: 'Reviews', book: 'On the shelf', list: 'Lists',
		author: 'Authors', genre: 'Genres',
	};
	const GROUP_ORDER: SearchEntry['type'][] = ['review', 'list', 'author', 'genre', 'book'];
	const GROUP_CAP: Record<SearchEntry['type'], number> = {
		review: 5, list: 2, author: 3, genre: 3, book: 3,
	};

	async function loadIndex() {
		if (loaded) return;
		loaded = true;
		try {
			const res = await fetch('/search-index.json');
			const data = (await res.json()) as SearchIndex;
			suggestions = data.suggestions;
			fuse = new Fuse(data.entries, {
				includeScore: true,
				ignoreLocation: true,
				threshold: 0.34,
				minMatchCharLength: 2,
				keys: [
					{ name: '_title', weight: 0.6 },
					{ name: '_author', weight: 0.3 },
					{ name: '_keywords', weight: 0.1 },
				],
			});
		} catch {
			resultsEl.innerHTML = '<div class="search-empty">Search is unavailable right now.</div>';
		}
	}

	const esc = (s: string) =>
		s.replace(/[&<>"']/g, (c) => (
			{ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string
		));

	function rowHtml(e: SearchEntry, navIdx: number): string {
		const clickable = !!e.url;
		const sub = e.subtitle ? `<span class="sr-sub">${esc(e.subtitle)}</span>` : '';
		const tag = !clickable ? '<span class="sr-soon">coming soon</span>' : '';
		const attrs = clickable
			? `data-url="${esc(e.url!)}" data-type="${e.type}" data-nav="${navIdx}" tabindex="-1"`
			: 'aria-disabled="true"';
		return `<div class="search-result${clickable ? '' : ' is-disabled'}" role="option" ${attrs}>
			<span class="sr-title">${esc(e.title)}</span>${sub}${tag}
		</div>`;
	}

	// Renders grouped results and returns the flat list of navigable URLs.
	let navUrls: string[] = [];
	function renderGroups(groups: { type: SearchEntry['type']; items: SearchEntry[] }[]) {
		navUrls = [];
		let html = '';
		for (const g of groups) {
			if (!g.items.length) continue;
			html += `<div class="search-group"><div class="search-group-label">${TYPE_LABEL[g.type]}</div>`;
			for (const e of g.items) {
				const navIdx = e.url ? navUrls.length : -1;
				if (e.url) navUrls.push(e.url);
				html += rowHtml(e, navIdx);
			}
			html += '</div>';
		}
		resultsEl.innerHTML = html;
		activeIdx = -1;
		setActive(navUrls.length ? 0 : -1);
	}

	function renderSuggestions() {
		if (!suggestions) { resultsEl.innerHTML = ''; return; }
		navUrls = [];
		let html = '';
		if (suggestions.genres.length) {
			html += '<div class="search-group"><div class="search-group-label">Browse genres</div><div class="search-pills">';
			for (const g of suggestions.genres) {
				html += `<a class="search-pill" href="${esc(g.url)}">${esc(g.label)}</a>`;
			}
			html += '</div></div>';
		}
		if (suggestions.reviews.length) {
			html += `<div class="search-group"><div class="search-group-label">Recent favourites</div>`;
			for (const e of suggestions.reviews) {
				navUrls.push(e.url!);
				html += rowHtml(e, navUrls.length - 1);
			}
			html += '</div>';
		}
		resultsEl.innerHTML = html;
		activeIdx = -1;
	}

	function runSearch(q: string) {
		if (!fuse) return;
		if (!q.trim()) { renderSuggestions(); searchInput.setAttribute('aria-expanded', 'false'); return; }
		const hits = fuse.search(q.trim(), { limit: 40 }).map((h) => h.item);
		const groups = GROUP_ORDER.map((type) => ({
			type,
			items: hits.filter((h) => h.type === type).slice(0, GROUP_CAP[type]),
		}));
		const any = groups.some((g) => g.items.length);
		searchInput.setAttribute('aria-expanded', any ? 'true' : 'false');
		if (!any) {
			resultsEl.innerHTML = `<div class="search-empty">No results for “${esc(q.trim())}”.</div>`;
			navUrls = [];
			activeIdx = -1;
			return;
		}
		renderGroups(groups);
	}

	function setActive(idx: number) {
		const rows = resultsEl.querySelectorAll<HTMLElement>('.search-result[data-nav]');
		rows.forEach((r) => r.classList.remove('is-active'));
		activeIdx = idx;
		if (idx < 0) return;
		const row = resultsEl.querySelector<HTMLElement>(`.search-result[data-nav="${idx}"]`);
		if (row) {
			row.classList.add('is-active');
			row.scrollIntoView({ block: 'nearest' });
		}
	}

	// Debounce input a touch so we don't re-render on every keystroke burst.
	let t = 0;
	let trackT = 0;
	let lastTrackedTerm = '';
	searchInput.addEventListener('input', () => {
		clearTimeout(t);
		t = window.setTimeout(() => runSearch(searchInput.value), 80);
		// Log the search term once typing settles — intent, not keystrokes. GA4's built-in
		// `search` event with `search_term` powers the Site-Search report.
		clearTimeout(trackT);
		trackT = window.setTimeout(() => {
			const q = searchInput.value.trim();
			if (q.length >= 2 && q !== lastTrackedTerm) {
				lastTrackedTerm = q;
				track('search', { search_term: q });
			}
		}, 700);
	});

	// Navigate to a chosen result, logging which one was picked.
	function selectResult(url: string, type?: string) {
		track('select_search_result', {
			search_term: searchInput.value.trim(),
			result_type: type ?? '',
			link_url: url,
		});
		window.location.href = url;
	}

	// Mouse interaction on result rows (event-delegated; rows are re-rendered).
	resultsEl.addEventListener('click', (e) => {
		const row = (e.target as HTMLElement).closest<HTMLElement>('.search-result[data-url]');
		if (row) selectResult(row.dataset.url!, row.dataset.type);
	});
	resultsEl.addEventListener('mousemove', (e) => {
		const row = (e.target as HTMLElement).closest<HTMLElement>('.search-result[data-nav]');
		if (row) setActive(parseInt(row.dataset.nav!, 10));
	});

	// Overlay open/close
	function openSearch() {
		closeMenu();
		overlay.style.display = 'flex';
		document.body.style.overflow = 'hidden';
		loadIndex().then(() => { if (!searchInput.value.trim()) renderSuggestions(); });
		setTimeout(() => searchInput.focus(), 50);
	}
	function closeSearch() {
		overlay.style.display = 'none';
		document.body.style.overflow = '';
		searchInput.value = '';
		resultsEl.innerHTML = '';
		navUrls = [];
		activeIdx = -1;
		searchInput.setAttribute('aria-expanded', 'false');
	}

	searchBtn.addEventListener('click', openSearch);
	document.getElementById('search-btn-m')?.addEventListener('click', openSearch);
	if (drawerSearch) drawerSearch.addEventListener('click', (e) => { e.preventDefault(); openSearch(); });
	searchClose.addEventListener('click', closeSearch);

	overlay.addEventListener('click', (e) => {
		if (e.target === overlay) closeSearch();
	});

	// Keyboard: ↑/↓ move highlight, Enter opens it, Esc closes.
	searchInput.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowDown' && navUrls.length) {
			e.preventDefault();
			setActive(activeIdx < 0 ? 0 : (activeIdx + 1) % navUrls.length);
		} else if (e.key === 'ArrowUp' && navUrls.length) {
			e.preventDefault();
			setActive(activeIdx <= 0 ? navUrls.length - 1 : activeIdx - 1);
		} else if (e.key === 'Enter') {
			if (activeIdx >= 0 && navUrls[activeIdx]) {
				const row = resultsEl.querySelector<HTMLElement>(`.search-result[data-nav="${activeIdx}"]`);
				selectResult(navUrls[activeIdx], row?.dataset.type);
			}
		}
	});

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') {
			if (overlay.style.display !== 'none') closeSearch();
			else if (menuOpen) closeMenu();
		}
		// "/" or Cmd/Ctrl+K opens search from anywhere.
		const tag = (e.target as HTMLElement)?.tagName;
		const typing = tag === 'INPUT' || tag === 'TEXTAREA' || (e.target as HTMLElement)?.isContentEditable;
		if (((e.key === '/' && !typing) || ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k'))
			&& overlay.style.display === 'none') {
			e.preventDefault();
			openSearch();
		}
	});
});
</script>
