---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { getNewsletters } from '../utils/newsletters';

const inside = [
  { label: 'Reviews', text: "My personal take on the books I've finished." },
  { label: 'Recommendations', text: 'Shortlists and recommendations worth your shelf space.' },
  { label: '& more', text: "What I'm currently reading, or other interesting notes!" },
];

const issues = getNewsletters(); // newest first
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="The Newsletter"
      description="A monthly letter from Saturdays in a Book: a featured review, a list, what I'm reading, and the month in books. No spam, unsubscribe anytime."
      ogImage="/og/default.png"
    />
  </head>
  <body>
    <Header />
    <main class="nlp">
      <div class="nlp-col">
        <NewsletterSignup variant="page" />

        <section class="nlp-inside">
          <p class="nlp-eyebrow">§ What to expect</p>
          <ul class="nlp-list">
            {inside.map((row) => (
              <li>
                <span class="nlp-item-label">{row.label}</span>
                <span class="nlp-item-text">{row.text}</span>
              </li>
            ))}
          </ul>
          <p class="nlp-foot">
            I love hearing from you, reply back with what you're reading, a thought on a book, or if you're looking for a recommendation!
          </p>
        </section>

        {issues.length > 0 && (
          <section class="nlp-issues">
            <p class="nlp-eyebrow">§ Past issues</p>
            <ul class="nlp-issue-list">
              {issues.map((issue) => (
                <li>
                  <a href={issue.href} class="nlp-issue">
                    <span class="nlp-issue-num">Issue {issue.num}</span>
                    <span class="nlp-issue-body">
                      <span class="nlp-issue-date">{issue.label}</span>
                      {issue.title && <span class="nlp-issue-title">{issue.title}</span>}
                    </span>
                    <span class="nlp-issue-arrow">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  .nlp { padding: clamp(28px, 6vw, 64px) 0 clamp(48px, 8vw, 96px); }
  .nlp-col {
    width: 100%;
    max-width: 640px;
    margin: 0 auto;
    padding: 0 clamp(22px, 5vw, 40px);
  }

  .nlp-inside { margin-top: clamp(40px, 6vw, 64px); }
  .nlp-eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 8px;
  }
  .nlp-list { list-style: none; margin: 0; padding: 0; }
  .nlp-list li {
    display: flex;
    gap: clamp(14px, 3vw, 28px);
    align-items: baseline;
    padding: 18px 0;
    border-top: 1px solid var(--rule);
  }
  .nlp-list li:last-child { border-bottom: 1px solid var(--rule); }
  .nlp-item-label {
    flex: 0 0 clamp(9rem, 26vw, 12rem);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    padding-top: 2px;
  }
  .nlp-item-text {
    font-family: var(--serif);
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.4;
    color: var(--ink-2);
  }
  .nlp-foot {
    font-family: var(--serif);
    font-style: italic;
    font-size: 16px;
    line-height: 1.5;
    color: var(--muted);
    margin: 28px 0 0;
  }

  .nlp-issues { margin-top: clamp(40px, 6vw, 64px); }
  .nlp-issue-list { list-style: none; margin: 0; padding: 0; }
  .nlp-issue-list li { border-top: 1px solid var(--rule); }
  .nlp-issue-list li:last-child { border-bottom: 1px solid var(--rule); }
  .nlp-issue {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(14px, 3vw, 28px);
    padding: 18px 6px;
    text-decoration: none;
    color: inherit;
    border-radius: 4px;
    transition: background 150ms;
  }
  .nlp-issue:hover { background: var(--highlight); }
  .nlp-issue-num {
    flex: 0 0 auto;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    white-space: nowrap;
  }
  .nlp-issue-body { min-width: 0; display: flex; flex-direction: column; gap: 3px; }
  .nlp-issue-date {
    font-family: var(--serif);
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.3;
    color: var(--ink);
  }
  .nlp-issue-title {
    font-family: var(--serif);
    font-size: 13px;
    line-height: 1.4;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .nlp-issue-arrow { color: var(--accent); font-size: 16px; }

  @media (max-width: 520px) {
    .nlp-list li { flex-direction: column; gap: 4px; }
    .nlp-item-label { flex-basis: auto; }
  }
</style>
