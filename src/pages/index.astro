---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HomeExperience from '../components/home/HomeExperience.astro';
import { SITE_TITLE, HOME_DESCRIPTION, CURRENTLY_READING_NOTES } from '../consts';
import currentlyReadingData from '../data/currently-reading.json';
import { getCollection } from 'astro:content';
import { getBlogUrl, getCoverColor } from '../utils/blog';
import { computeStats } from '../utils/stats';
import shelfData from '../data/shelf.json';

const allPosts = await getCollection('blog', ({ data }) => data.status === 'live');
const sorted   = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const reviews = sorted.filter((p) => p.data.postType === 'review');
const lists   = sorted.filter((p) => p.data.postType === 'list');

const cover = (url?: string | null) => (url && url !== 'TK' ? url : null);
const mapPicks = (post: (typeof lists)[number]) =>
	(post.data.picks ?? []).map((p) => ({ title: p.bookTitle, author: p.author ?? null, cover: cover(p.cover), url: p.reviewUrl ?? null }));

// ── Screen 01 — latest review ───────────────────────────────────────────────
const latestPost = reviews[0];
const latest = latestPost && {
	title: latestPost.data.bookTitle || latestPost.data.title,
	author: latestPost.data.author ?? null,
	rating: latestPost.data.rating ?? null,
	date: latestPost.data.pubDate,
	blurb: latestPost.data.description ?? null,
	cover: cover(latestPost.data.heroImage),
	url: getBlogUrl(latestPost.id),
};

// ── Screen 01 §02 — currently reading ───────────────────────────────────────
type CurrentBook = { goodreadsId: string; title: string; author: string; coverUrl: string | null };
const crBook = (currentlyReadingData as CurrentBook[])[0];
const crNotes = crBook ? CURRENTLY_READING_NOTES[crBook.goodreadsId] ?? {} : {};
const crFallback = crBook ? getCoverColor(crBook.title) : null;
const current = crBook && crFallback ? {
	title: crBook.title,
	author: crBook.author,
	cover: cover(crBook.coverUrl),
	coverBg: crNotes.coverBg ?? crFallback.bg,
	coverInk: crNotes.coverInk ?? crFallback.ink,
	progress: crNotes.progress ?? '',
	url: crNotes.url ?? '',
} : null;

// ── Screen 01 §03 — featured-list teaser ────────────────────────────────────
const featuredPost = lists[0];
const featured = featuredPost && {
	title: featuredPost.data.title,
	blurb: featuredPost.data.description ?? null,
	picks: mapPicks(featuredPost),
	count: (featuredPost.data.picks ?? []).length,
	date: featuredPost.data.pubDate,
	url: getBlogUrl(featuredPost.id),
};

// ── Screen 02 — recent reading (next reviews after the latest) ──────────────
const recent = reviews.slice(1, 33).map((p) => ({
	title: p.data.bookTitle || p.data.title,
	author: p.data.author ?? null,
	rating: p.data.rating ?? null,
	cover: cover(p.data.heroImage),
	url: getBlogUrl(p.id),
}));
const recentRow1 = recent.slice(0, 16);
const recentRow2 = recent.slice(16, 32);

// ── Screen 03 — 4-cell editorial quadrant: 1 list + 2 archive gems + the 5★ shelf
const shelfByGid = new Map(shelfData.map((b: any) => [String(b.goodreadsId), b]));
const gid = (p: (typeof reviews)[number]) => String(p.data.goodreadsId ?? '');
// First substantive line of the review body — a real pull-quote (the meta `description`
// on older reviews is a generic "A thoughtful review of …" placeholder).
const firstLine = (body?: string): string | null => {
	const para = (body ?? '').split('\n').map((l) => l.trim())
		.find((l) => l && !/^[#>|]/.test(l) && !l.startsWith('![') && !l.startsWith('<'));
	if (!para) return null;
	const c = para.replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1').replace(/[*_`#]/g, '').trim();
	return c.length > 30 ? c : null;
};
const reviewBook = (p: (typeof reviews)[number]) => ({
	title: p.data.bookTitle || p.data.title,
	author: p.data.author ?? null,
	rating: p.data.rating ?? null,
	quote: firstLine(p.body) ?? p.data.description ?? null,
	cover: cover(p.data.heroImage),
	url: getBlogUrl(p.id),
});

// Books already on screen 1/2, so the archive surfaces things you'd otherwise miss.
const shown = new Set([latestPost, ...reviews.slice(1, 21)].filter(Boolean).map(gid));

// Archive gems — top-rated reviewed books read in 2019, not already shown.
const archivePool = reviews.filter((p) => {
	const s = shelfByGid.get(gid(p));
	return s && (s.readYears ?? []).includes(2019) && p.data.rating === 5 && !shown.has(gid(p));
}).sort((a, b) => (b.body?.length ?? 0) - (a.body?.length ?? 0)); // most substantive reviews first
const archiveGems = archivePool.slice(0, 2).map(reviewBook);
const gemGids = new Set(archivePool.slice(0, 2).map(gid));

// The Five-Star Shelf — 5★ reviews not already featured.
const fiveStarAll = reviews.filter((p) => p.data.rating === 5);
const fiveStarPicks = fiveStarAll
	.filter((p) => !shown.has(gid(p)) && !gemGids.has(gid(p)))
	.slice(0, 8)
	.map((p) => ({ title: p.data.bookTitle || p.data.title, author: p.data.author ?? null, cover: cover(p.data.heroImage), url: getBlogUrl(p.id) }));

// The list cell — the list NOT teased on screen 1 (lists[0]).
const listCellPost = lists[1] ?? lists[0];
const listCell = listCellPost && {
	type: 'list' as const, href: getBlogUrl(listCellPost.id),
	title: listCellPost.data.title, blurb: listCellPost.data.description ?? null,
	count: (listCellPost.data.picks ?? []).length, picks: mapPicks(listCellPost),
};

// Quadrant order = cell position 0..3 (tall-left, wide-top, bottom-mid, bottom-right).
const quadCells = [
	archiveGems[0] && { type: 'review' as const, href: archiveGems[0].url, kicker: 'From the archive · 2019', book: archiveGems[0] },
	listCell,
	archiveGems[1] && { type: 'review' as const, href: archiveGems[1].url, kicker: 'From the archive · 2019', book: archiveGems[1] },
	fiveStarPicks.length ? { type: 'collection' as const, href: '/book-reviews?rating=5', title: 'The Five-Star Shelf', blurb: 'Every book I gave the full five stars.', count: fiveStarAll.length, picks: fiveStarPicks } : null,
].filter(Boolean);

// ── Screen 04 — reading stats (real aggregates) ─────────────────────────────
const stats = computeStats();
const years = stats.timeline.year.books;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={HOME_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			{latest && (
				<HomeExperience
					latest={latest}
					current={current}
					featured={featured}
					recentRow1={recentRow1}
					recentRow2={recentRow2}
					cells={quadCells}
					stats={{ uniqueBooks: stats.uniqueBooks, uniqueAuthors: stats.uniqueAuthors, pagesRead: stats.pagesRead }}
					years={years}
					urls={{ allReviews: '/book-reviews', stats: '/stats', shelf: '/book-reviews' }}
				/>
			)}
		</main>
		<Footer />
	</body>
</html>
