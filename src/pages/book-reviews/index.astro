---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { buildShelf } from '../../utils/shelf';
import { getCoverColor as cc } from '../../utils/blog';
import PageMasthead from '../../components/PageMasthead.astro';

// Live reviews join the Goodreads shelf (src/data/shelf.json) to produce one
// card per book read: reviewed → clickable, otherwise "review coming soon".
const reviews = (await getCollection('blog', ({ data }) => data.status === 'live'))
	.filter(p => p.data.postType === 'review');

const { cards, total, reviewedCount } = buildShelf(reviews);

// Author list for filter combobox (across the whole shelf, reviewed or not)
const authorCounts: Record<string, number> = {};
cards.forEach(c => { if (c.author) authorCounts[c.author] = (authorCounts[c.author] || 0) + 1; });
const authors = Object.keys(authorCounts).sort();

// Subgenre list from shelf data, sorted alphabetically
const subgenreSet = new Set<string>();
cards.forEach(c => c.subgenres.forEach(s => subgenreSet.add(s)));
const allSubgenres = [...subgenreSet].sort();

// Country list for the filter combobox (whole shelf, reviewed or not)
const countrySet = new Set<string>();
cards.forEach(c => { if (c.country) countrySet.add(c.country); });
const countries = [...countrySet].sort();

// Per-year counts for the client rail (grouped by year read)
const yearCounts: Record<string, number> = {};
cards.forEach(c => { const y = String(c.year); yearCounts[y] = (yearCounts[y] || 0) + 1; });

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="All Book Reviews — Saturdays in a Book" description="Every book I've reviewed, filterable by genre, author, and tag." ogImage="/og/default.png" />
	</head>
	<body>
		<Header />
		<main>

			<!-- Page header -->
			<PageMasthead eyebrow="My Bookshelf" title="Browse my collection">
				<Fragment slot="meta">
					<span class="eyebrow-mono">{total} books read · {reviewedCount} reviewed</span>
				</Fragment>
			</PageMasthead>

			<!-- Filter bar (sticky) -->
			<div class="filter-bar-wrap" id="filter-bar-wrap">
				<div class="bleed filter-bar">

						<!-- Desktop: [Viewing X / Y books] ‖ [filters in two rows]. Mobile: hidden (pill). -->
						<div class="fb-row">

							<!-- Lead group: collapse chevron + "Viewing X / Y books" stat.
							     On wide desktop this sits in the gutter, above the year rail. -->
							<div class="fb-lead">
								<button class="fb-collapse-btn fb-toggle" id="fb-toggle-btn" title="Hide filters" aria-label="Hide filters">
									<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
										<path d="M3 5.5l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"/>
									</svg>
								</button>
								<div class="fb-count-block" id="result-count">
									<span class="fbc-label">Viewing</span>
									<span class="fbc-stat"><span id="count-num">{reviewedCount}</span><span class="fbc-slash">/</span><span class="fbc-total">{total}</span></span>
									<span class="fbc-unit">books</span>
								</div>
							</div>

							<div class="fb-filters">

							<!-- Mobile-only sheet trigger (opens the filter bottom sheet) -->
							<button class="fb-sheet-trigger" id="fb-sheet-trigger" aria-haspopup="dialog" aria-expanded="false" aria-controls="fb-controls">
								<svg width="15" height="15" viewBox="0 0 15 15" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
									<line x1="2" y1="4" x2="13" y2="4" stroke-linecap="round"/>
									<line x1="2" y1="7.5" x2="13" y2="7.5" stroke-linecap="round"/>
									<line x1="2" y1="11" x2="13" y2="11" stroke-linecap="round"/>
									<circle cx="10" cy="4" r="1.6" fill="var(--bg)"/>
									<circle cx="5" cy="7.5" r="1.6" fill="var(--bg)"/>
									<circle cx="9" cy="11" r="1.6" fill="var(--bg)"/>
								</svg>
								<span>Filters</span>
								<span class="fb-sheet-badge" id="fb-sheet-badge" hidden>0</span>
							</button>

							<!-- Collapsible controls (becomes a bottom sheet on mobile) -->
							<div class="fb-controls" id="fb-controls">
								<div class="fb-sheet-head">
									<span class="fb-sheet-title">Filters</span>
									<button class="fb-sheet-reset" id="fb-sheet-reset" type="button">Reset</button>
								</div>
								<div class="fb-divider"></div>

								<div class="fb-seg" id="genre-seg" role="group" aria-label="Genre filter">
									<button class="fb-seg-btn is-on" data-genre="all">All</button>
									<button class="fb-seg-btn" data-genre="fiction">Fiction</button>
									<button class="fb-seg-btn" data-genre="nonfiction">Nonfiction</button>
								</div>

								<div class="fb-combo" id="subgenre-combo">
									<button class="fb-combo-btn" id="subgenre-combo-btn" aria-haspopup="listbox" aria-expanded="false">
										<span class="fb-combo-pill">Genre</span>
										<span class="fb-combo-value" id="subgenre-combo-value">Any</span>
										<span class="fb-combo-x" aria-label="Clear genre filter">×</span>
										<svg class="fb-combo-caret" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4">
											<path d="M2.5 4.5l3.5 3.5 3.5-3.5" stroke-linecap="round" stroke-linejoin="round"/>
										</svg>
									</button>
									<div class="fb-combo-pop" id="subgenre-combo-pop" style="display:none" role="listbox">
										<div class="fb-combo-search-wrap">
											<svg width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="5.5" cy="5.5" r="3.5"/><line x1="8.2" y1="8.2" x2="11" y2="11" stroke-linecap="round"/></svg>
											<input class="fb-combo-search" type="text" placeholder="Search genres…" autocomplete="off" />
										</div>
										<div class="fb-combo-list" id="subgenre-combo-list">
											{allSubgenres.map(s => (
												<button class="fb-combo-opt" role="option" data-subgenre={s}>
													{s.charAt(0).toUpperCase() + s.slice(1)}
													<svg class="fb-combo-check" style="display:none" width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2.5 6.5l3 3 5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
												</button>
											))}
										</div>
									</div>
								</div>

								<div class="fb-divider"></div>

								<div class="fb-seg" id="status-seg" role="group" aria-label="Review status filter">
									<button class="fb-seg-btn is-on" data-status="reviewed">Reviewed</button>
									<button class="fb-seg-btn" data-status="all">Entire Shelf</button>
								</div>

								<div class="fb-divider"></div>

								<div class="fb-combo" id="author-combo">
									<button class="fb-combo-btn" id="author-combo-btn" aria-haspopup="listbox" aria-expanded="false">
										<span class="fb-combo-pill">Author</span>
										<span class="fb-combo-value" id="author-combo-value">Any</span>
										<span class="fb-combo-x" aria-label="Clear author filter">×</span>
										<svg class="fb-combo-caret" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4">
											<path d="M2.5 4.5l3.5 3.5 3.5-3.5" stroke-linecap="round" stroke-linejoin="round"/>
										</svg>
									</button>
									<div class="fb-combo-pop" id="author-combo-pop" style="display:none" role="listbox">
										<div class="fb-combo-search-wrap">
											<svg width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="5.5" cy="5.5" r="3.5"/><line x1="8.2" y1="8.2" x2="11" y2="11" stroke-linecap="round"/></svg>
											<input class="fb-combo-search" type="text" placeholder="Search authors…" autocomplete="off" />
										</div>
										<div class="fb-combo-list" id="author-combo-list">
											{authors.map(a => (
												<button class="fb-combo-opt" role="option" data-author={a}>
													{a}
													<svg class="fb-combo-check" style="display:none" width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2.5 6.5l3 3 5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
												</button>
											))}
										</div>
									</div>
								</div>

								<div class="fb-sheet-foot">
									<button class="fb-sheet-apply" id="fb-sheet-apply" type="button">Show <span id="fb-sheet-count">{total}</span> books</button>
								</div>
							</div>

							<!-- Sort + view -->
							<div class="fb-bar-actions">
							<div class="fb-actions-end">
							<!-- Sort -->
							<div class="fb-group fb-sort">
								<div class="fb-select-wrap">
									<svg class="fb-sort-icon" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="M4.5 3v10M4.5 13l-2-2M4.5 13l2-2"/>
										<path d="M11.5 13V3M11.5 3l-2 2M11.5 3l2 2"/>
									</svg>
									<select id="sort-select">
										<option value="date-desc">Recently read</option>
										<option value="date-asc">First read</option>
										<option value="rating">Rating ↓</option>
										<option value="title">Title A–Z</option>
									</select>
									<svg class="fb-select-caret" width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.4">
										<path d="M2 4l3 3 3-3" stroke-linecap="round" stroke-linejoin="round"/>
									</svg>
								</div>
							</div>

							<!-- View toggle -->
							<div class="fb-view" role="group" aria-label="View">
								<button class="is-on" id="view-grid" aria-label="Grid view" title="Grid view">
									<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3">
										<rect x="1" y="1" width="5" height="5"/><rect x="8" y="1" width="5" height="5"/>
										<rect x="1" y="8" width="5" height="5"/><rect x="8" y="8" width="5" height="5"/>
									</svg>
								</button>
								<button id="view-list" aria-label="List view" title="List view">
									<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3">
										<line x1="1" y1="3" x2="13" y2="3"/><line x1="1" y1="7" x2="13" y2="7"/>
										<line x1="1" y1="11" x2="13" y2="11"/>
									</svg>
								</button>
							</div>
							</div>
							</div>
						</div>
						</div>
					</div>
				</div>
			<div class="fb-sheet-backdrop" id="fb-sheet-backdrop" hidden></div>

			<!-- Per-year counts for the client rail (authoritative, build-time) -->
			<script type="application/json" id="yr-counts" set:html={JSON.stringify(yearCounts)}></script>

			<!-- Results — single continuous grid; years tracked via data-year -->
			<div class="bleed idx-results" id="results-area">

						<!-- Grid view -->
						<div class="idx-results-grid view-grid">
								{cards.map((card) => {
									const c = cc(card.title);
									const Tag = card.reviewed ? 'a' : 'div';
									return (
										<Tag
											href={card.reviewed ? card.url : undefined}
											class:list={["post-item rev-card", { "is-coming-soon": !card.reviewed }]}
											data-year={card.year}
											data-genre={card.genre.toLowerCase()}
											data-category={card.category}
											data-subgenres={card.subgenres.join('|')}
											data-classic={card.classic ? 'true' : ''}
											data-author={card.author.toLowerCase()}
											data-country={card.country.toLowerCase()}
											data-tags={card.tags.join('|').toLowerCase()}
											data-rating={card.rating || ''}
											data-date={card.dateRead}
											data-title={card.title.toLowerCase()}
											data-status={card.reviewed ? 'reviewed' : 'coming-soon'}
										>
											{card.cover ? (
												<div class="cover cover-photo">
													<img src={card.cover} alt={card.title} loading="lazy" />
													{!card.reviewed && <span class="cs-badge">Review coming soon</span>}
												</div>
											) : (
												<div class="cover" style={`background:${c.bg};color:${c.ink}`}>
													<div class="spine"></div>
													<div class="gloss"></div>
													<div class="cover-sub">{card.author}</div>
													<div class="cover-label">{card.title.toUpperCase()}</div>
													{!card.reviewed && <span class="cs-badge">Review coming soon</span>}
												</div>
											)}
											<div class="rc-meta">
												{card.author && <span class="rc-author">{card.author}</span>}
												<h3>{card.title}</h3>
												{card.rating && (
													<span class="rating">
														{Array.from({ length: 5 }, (_, i) => (
															<svg class="star" viewBox="0 0 16 16" fill={i < card.rating! ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.2">
																<path d="M8 1.5l2 4.5 4.8.4-3.6 3.2 1.1 4.8L8 11.9 3.7 14.4l1.1-4.8L1.2 6.4 6 6z" stroke-linejoin="round" stroke-linecap="round"/>
															</svg>
														))}
													</span>
												)}
												{card.blurb && (
													<p class="rc-blurb">{card.blurb}</p>
												)}
												<div class="rc-foot">
													<FormattedDate date={new Date(card.dateRead)} />
													{card.readCount > 1 && <span class="rc-reread">Read {card.readCount}×</span>}
												</div>
											</div>
										</Tag>
									);
								})}
							</div>

							<!-- List view -->
							<div class="idx-results-list view-list" style="display:none">
								{cards.map((card) => {
									const c = cc(card.title);
									const Tag = card.reviewed ? 'a' : 'div';
									return (
										<Tag
											href={card.reviewed ? card.url : undefined}
											class:list={["lst-row post-item", { "is-coming-soon": !card.reviewed }]}
											data-year={card.year}
											data-genre={card.genre.toLowerCase()}
											data-category={card.category}
											data-subgenres={card.subgenres.join('|')}
											data-classic={card.classic ? 'true' : ''}
											data-author={card.author.toLowerCase()}
											data-country={card.country.toLowerCase()}
											data-tags={card.tags.join('|').toLowerCase()}
											data-rating={card.rating || ''}
											data-date={card.dateRead}
											data-title={card.title.toLowerCase()}
											data-status={card.reviewed ? 'reviewed' : 'coming-soon'}
										>
											{card.cover ? (
												<div class="cover cover-photo">
													<img src={card.cover} alt={card.title} loading="lazy" />
												</div>
											) : (
												<div class="cover" style={`background:${c.bg};color:${c.ink}`}>
													<div class="spine"></div>
													<div class="gloss"></div>
													<div class="cover-label">{card.title.toUpperCase()}</div>
												</div>
											)}
											<div>
												<h3>{card.title}</h3>
												{card.author && <div class="lst-author">{card.author}</div>}
											</div>
											<div class="lst-meta">
												{card.rating && (
													<span class="rating">
														{Array.from({ length: 5 }, (_, i) => (
															<svg class="star" viewBox="0 0 16 16" fill={i < card.rating! ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.2">
																<path d="M8 1.5l2 4.5 4.8.4-3.6 3.2 1.1 4.8L8 11.9 3.7 14.4l1.1-4.8L1.2 6.4 6 6z" stroke-linejoin="round" stroke-linecap="round"/>
															</svg>
														))}
													</span>
												)}
												{!card.reviewed && <span class="cs-pill">Coming soon</span>}
												<FormattedDate date={new Date(card.dateRead)} />
												{card.readCount > 1 && <span class="rc-reread">Read {card.readCount}×</span>}
											</div>
										</Tag>
									);
								})}
							</div>

				<div class="empty" id="no-results" style="display:none">
					No books match your filters.
				</div>
			</div>

		</main>
		<Footer />

		<!-- Floating rail (only renders at >1250px via CSS). Adapts to the active
		     sort: years (date), ghost alphabet (title), or star rating (rating). -->
		<aside class="year-rail mode-year" id="year-rail" aria-hidden="true">
			<div class="yr-tick" id="yr-tick">§ Year</div>

			<!-- Year mode -->
			<div class="yr-now">
				<span class="yr-now-label" id="yr-now-label"></span>
			</div>
			<div class="yr-count" id="yr-now-meta"></div>
			<div class="yr-track">
				<div class="yr-track-bg"></div>
				<div class="yr-track-fill" id="yr-track-fill"></div>
				<div class="yr-track-dot"  id="yr-track-dot"></div>
			</div>
			<div class="yr-soon" id="yr-soon" style="display:none">
				<span class="yr-soon-arrow">↓</span>
				<span id="yr-soon-label"></span>
			</div>
			<div class="yr-count" id="yr-soon-meta" style="display:none"></div>

			<!-- Alpha mode: ghost alphabet (# A B … Z) -->
			<div class="yr-alpha" id="yr-alpha">
				{['#', ...'ABCDEFGHIJKLMNOPQRSTUVWXYZ'].map(ch => (
					<span class="yr-alpha-ch" data-ch={ch}>{ch}</span>
				))}
			</div>

			<!-- Rating mode: five stars, current rating filled -->
			<div class="yr-rating" id="yr-rating">
				{Array.from({ length: 5 }, () => (
					<svg class="yr-star" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2">
						<path d="M8 1.5l2 4.5 4.8.4-3.6 3.2 1.1 4.8L8 11.9 3.7 14.4l1.1-4.8L1.2 6.4 6 6z" stroke-linejoin="round" stroke-linecap="round"/>
					</svg>
				))}
			</div>

			<div class="yr-meta" id="yr-meta"></div>
		</aside>

		<!-- Sticky pill (≤1250px) — on mobile (≤720px) it doubles as the filter toolbar -->
		<div class="year-pill mode-year" id="year-pill" aria-hidden="true">
			<span class="year-pill-label">
				<span class="year-pill-year" id="year-pill-year"></span>
				<span class="year-pill-stars" id="year-pill-stars">
					{Array.from({ length: 5 }, () => (
						<svg class="yr-star" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2">
							<path d="M8 1.5l2 4.5 4.8.4-3.6 3.2 1.1 4.8L8 11.9 3.7 14.4l1.1-4.8L1.2 6.4 6 6z" stroke-linejoin="round" stroke-linecap="round"/>
						</svg>
					))}
				</span>
				<span class="pill-sep" aria-hidden="true"></span>
				<span class="year-pill-meta" id="year-pill-meta"></span>
			</span>

			<!-- Mobile toolbar actions -->
			<span class="pill-actions">
				<span class="pill-divider"></span>
				<button class="pill-btn" id="pill-filter" aria-label="Filters">
					<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
						<line x1="2.5" y1="4.5" x2="13.5" y2="4.5" stroke-linecap="round"/>
						<line x1="2.5" y1="8" x2="13.5" y2="8" stroke-linecap="round"/>
						<line x1="2.5" y1="11.5" x2="13.5" y2="11.5" stroke-linecap="round"/>
						<circle cx="10.5" cy="4.5" r="1.7" fill="var(--bg)"/>
						<circle cx="5.5" cy="8" r="1.7" fill="var(--bg)"/>
						<circle cx="9.5" cy="11.5" r="1.7" fill="var(--bg)"/>
					</svg>
					<span class="pill-badge" id="pill-filter-badge" hidden>0</span>
				</button>
				<button class="pill-btn" id="pill-sort" aria-label="Sort" aria-haspopup="listbox" aria-expanded="false">
					<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M4.5 3v10M4.5 13l-2-2M4.5 13l2-2"/>
						<path d="M11.5 13V3M11.5 3l-2 2M11.5 3l2 2"/>
					</svg>
				</button>
				<button class="pill-btn pill-view" id="pill-view" aria-label="Toggle list / grid view">
					<svg class="pill-view-grid" width="15" height="15" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
						<rect x="1" y="1" width="5" height="5"/><rect x="8" y="1" width="5" height="5"/>
						<rect x="1" y="8" width="5" height="5"/><rect x="8" y="8" width="5" height="5"/>
					</svg>
					<svg class="pill-view-list" width="15" height="15" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
						<line x1="1" y1="3" x2="13" y2="3"/><line x1="1" y1="7" x2="13" y2="7"/><line x1="1" y1="11" x2="13" y2="11"/>
					</svg>
				</button>
			</span>

			<!-- Sort options popover (opens above the pill) -->
			<div class="pill-sort-pop" id="pill-sort-pop" hidden role="listbox" aria-label="Sort by">
				<button class="pill-sort-opt is-on" role="option" data-sort="date-desc">Recently read<svg class="pill-sort-check" width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2.5 6.5l3 3 5-5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
				<button class="pill-sort-opt" role="option" data-sort="date-asc">First read<svg class="pill-sort-check" width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2.5 6.5l3 3 5-5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
				<button class="pill-sort-opt" role="option" data-sort="rating">Rating ↓<svg class="pill-sort-check" width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2.5 6.5l3 3 5-5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
				<button class="pill-sort-opt" role="option" data-sort="title">Title A–Z<svg class="pill-sort-check" width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2.5 6.5l3 3 5-5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
			</div>
		</div>

		<button class="back-to-top" id="back-to-top" aria-label="Back to top">
			<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
				<path d="M7 11.5V2.5"/><path d="M3 6.5l4-4 4 4"/>
			</svg>
		</button>
	</body>
</html>

<style>
.index-hero {
	padding-top: clamp(36px, 5vw, 64px);
	padding-bottom: clamp(20px, 2.5vw, 32px);
}

</style>

<script>
import { track } from '../../utils/analytics';

document.addEventListener('DOMContentLoaded', () => {

	// ── Stick filter bar below header
	const siteHeader = document.getElementById('site-header');
	const filterBarWrap = document.getElementById('filter-bar-wrap');
	if (siteHeader && filterBarWrap) {
		const setFilterTop = () => { filterBarWrap.style.top = `${siteHeader.offsetHeight}px`; };
		setFilterTop();
		window.addEventListener('resize', setFilterTop, { passive: true });
	}

	// ── Back to top
	const btt = document.getElementById('back-to-top');
	if (btt) {
		window.addEventListener('scroll', () => btt.classList.toggle('is-visible', window.scrollY > 600), { passive: true });
		btt.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
	}

	// ── Year rail
	const yearRail    = document.getElementById('year-rail');
	const yrTick      = document.getElementById('yr-tick');
	const yrNowLabel  = document.getElementById('yr-now-label');
	const yrTrackFill = document.getElementById('yr-track-fill');
	const yrTrackDot  = document.getElementById('yr-track-dot');
	const yrSoon      = document.getElementById('yr-soon');
	const yrSoonLabel = document.getElementById('yr-soon-label');
	const yrNowMeta   = document.getElementById('yr-now-meta');
	const yrSoonMeta  = document.getElementById('yr-soon-meta');
	const yrMeta      = document.getElementById('yr-meta');
	const yrAlpha     = document.getElementById('yr-alpha');
	const yrRating    = document.getElementById('yr-rating');
	const resultsArea = document.getElementById('results-area');
	const yearPill      = document.getElementById('year-pill');
	const yearPillYear  = document.getElementById('year-pill-year');
	const yearPillStars = document.getElementById('year-pill-stars');
	const yearPillMeta  = document.getElementById('year-pill-meta');
	const gridEl = resultsArea?.querySelector<HTMLElement>('.idx-results-grid') || null;

	// Rail display mode, driven by the active sort. 'year' tracks year blocks,
	// 'alpha' the first letter of the title, 'rating' the star count.
	let railMode: 'year' | 'alpha' | 'rating' = 'year';
	const TICK_LABEL = { year: '§ Year', alpha: '§ A–Z', rating: '§ Rating' };

	// Group key for the current card under whichever dimension railMode tracks.
	function groupKeyOf(card: HTMLElement): string {
		if (railMode === 'alpha') {
			const ch = (card.dataset.title || '').charAt(0).toUpperCase();
			return ch >= 'A' && ch <= 'Z' ? ch : '#';
		}
		if (railMode === 'rating') return card.dataset.rating || '0';
		return card.dataset.year || '';
	}

	const PALETTE = ['var(--accent)', 'var(--accent-2)'];
	let anchors: { key: string; el: HTMLElement }[] = []; // first card of each group, in DOM order
	let groupCount: Record<string, number> = {};          // group key -> visible card count
	let presentLetters = new Set<string>();               // first-letters present (alpha mode)
	let railEnabled = true;

	// Build one anchor per contiguous group block from the (visible) grid cards,
	// and tally visible counts per group. Scoped to the grid only, so the list-view
	// copies are never double-counted. O(visible cards), runs only on data changes.
	function buildYearAnchors() {
		anchors = [];
		groupCount = {};
		presentLetters = new Set();
		if (!gridEl) return;
		let lastKey: string | null = null;
		Array.from(gridEl.querySelectorAll<HTMLElement>('.post-item')).forEach(card => {
			if (card.classList.contains('is-hidden')) return;
			const k = groupKeyOf(card);
			groupCount[k] = (groupCount[k] || 0) + 1;
			if (railMode === 'alpha') presentLetters.add(k);
			if (k !== lastKey) { anchors.push({ key: k, el: card }); lastKey = k; }
		});
	}

	let raf = 0;
	function update() {
		raf = 0;
		if (!resultsArea) return;

		const isDesktop = window.innerWidth > 1250;
		const filterBottom = filterBarWrap ? filterBarWrap.getBoundingClientRect().bottom : 0;
		const line = Math.max(window.innerHeight * 0.42, filterBottom + 80);
		const wrapRect = resultsArea.getBoundingClientRect();
		const inResults = wrapRect.top < line && wrapRect.bottom > line + 60;
		const active = railEnabled && inResults && anchors.length >= 2;

		if (isDesktop) {
			if (yearRail) yearRail.style.top = `${Math.max(120, filterBottom + 32)}px`;
			yearRail?.classList.toggle('is-visible', active);
			yearPill?.classList.remove('is-visible');
		} else {
			yearPill?.classList.toggle('is-visible', active);
			yearRail?.classList.remove('is-visible');
		}
		if (!active) {
			// On mobile the pill is a persistent toolbar; when not tracking a group
			// (top of page, or <2 groups) it shows the total: "All · N books".
			if (window.innerWidth <= 720 && yearPill) {
				yearPill.classList.remove('mode-alpha', 'mode-rating');
				yearPill.classList.add('mode-year');
				const total = document.getElementById('count-num')?.textContent || '';
				if (yearPillYear) yearPillYear.textContent = 'All';
				if (yearPillMeta) yearPillMeta.textContent = `${total} books`;
			}
			return;
		}

		// Current year = last anchor whose top has passed the read line.
		let idx = 0;
		for (let i = 0; i < anchors.length; i++) {
			if (anchors[i].el.getBoundingClientRect().top <= line) idx = i;
		}
		const cur = anchors[idx];
		const nxt = anchors[idx + 1];
		const curTop = cur.el.getBoundingClientRect().top;
		const endY   = nxt ? nxt.el.getBoundingClientRect().top : wrapRect.bottom;
		const span   = Math.max(1, endY - curTop);
		const t      = Math.max(0, Math.min(1, (line - curTop) / span)); // progress within group (for color)

		// Fill is pixel-proportional over the whole results area → smooth, no
		// per-group-slice jumps regardless of how lopsided the group sizes are.
		const cursor = Math.max(0, Math.min(1, (line - wrapRect.top) / Math.max(1, wrapRect.height)));

		const curC  = PALETTE[idx % 2];
		const nxtC  = PALETTE[(idx + 1) % 2];
		const blend = `color-mix(in oklab, ${curC} ${Math.round((1 - t) * 100)}%, ${nxtC})`;
		const n = groupCount[cur.key] || 0;
		const meta = `${n} book${n !== 1 ? 's' : ''}`;
		const nn = nxt ? (groupCount[nxt.key] || 0) : 0;
		const soonMeta = `${nn} book${nn !== 1 ? 's' : ''}`;
		const modeClass = `mode-${railMode}`;

		if (isDesktop && yearRail) {
			yearRail.classList.remove('mode-year', 'mode-alpha', 'mode-rating');
			yearRail.classList.add(modeClass);
			if (yrTick) yrTick.textContent = TICK_LABEL[railMode];
			if (yrMeta) yrMeta.textContent = meta;

			if (railMode === 'year') {
				yearRail.style.setProperty('--rail-color', blend);
				yearRail.style.setProperty('--rail-color-nxt', nxtC);
				if (yrNowLabel) yrNowLabel.textContent = cur.key;
				if (yrNowMeta) yrNowMeta.textContent = meta;
				if (yrTrackFill) { yrTrackFill.style.height = `${cursor * 100}%`; yrTrackFill.style.background = blend; }
				if (yrTrackDot)  { yrTrackDot.style.top = `${cursor * 100}%`;  yrTrackDot.style.background = blend; }
				if (yrSoon && yrSoonLabel) {
					if (nxt) {
						yrSoon.style.display = '';
						yrSoon.style.color = nxtC;
						yrSoonLabel.textContent = nxt.key;
						if (yrSoonMeta) { yrSoonMeta.style.display = ''; yrSoonMeta.textContent = soonMeta; }
					} else {
						yrSoon.style.display = 'none';
						if (yrSoonMeta) yrSoonMeta.style.display = 'none';
					}
				}
			} else if (railMode === 'alpha' && yrAlpha) {
				yrAlpha.querySelectorAll<HTMLElement>('.yr-alpha-ch').forEach(ch => {
					ch.classList.toggle('is-present', presentLetters.has(ch.dataset.ch || ''));
					ch.classList.toggle('is-current', ch.dataset.ch === cur.key);
				});
			} else if (railMode === 'rating' && yrRating) {
				const r = parseInt(cur.key, 10) || 0;
				yrRating.querySelectorAll<SVGElement>('.yr-star').forEach((star, i) => {
					star.classList.toggle('filled', i < r);
				});
			}
		} else if (!isDesktop) {
			yearPill?.classList.remove('mode-year', 'mode-alpha', 'mode-rating');
			yearPill?.classList.add(modeClass);
			if (yearPillMeta) yearPillMeta.textContent = meta;
			if (railMode === 'rating') {
				const r = parseInt(cur.key, 10) || 0;
				yearPillStars?.querySelectorAll<SVGElement>('.yr-star').forEach((star, i) => {
					star.classList.toggle('filled', i < r);
				});
			} else if (yearPillYear) {
				yearPillYear.textContent = cur.key;
			}
		}
	}

	if (resultsArea) {
		buildYearAnchors();
		const onScroll = () => { if (!raf) raf = requestAnimationFrame(update); };
		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', () => { buildYearAnchors(); onScroll(); });
		update();
	}

	// ── Sort
	let activeSort = 'date-desc';
	const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;

	function applySort() {
		// Pick the rail dimension that matches the active sort.
		railMode = activeSort === 'title' ? 'alpha' : activeSort === 'rating' ? 'rating' : 'year';
		railEnabled = true;

		// Sort the flat grid and list containers directly.
		['.idx-results-grid', '.idx-results-list'].forEach(sel => {
			const container = resultsArea?.querySelector<HTMLElement>(sel);
			if (!container) return;
			const items = Array.from(container.children) as HTMLElement[];
			items.sort((a, b) => {
				if (activeSort === 'date-desc') return (b.dataset.date || '').localeCompare(a.dataset.date || '');
				if (activeSort === 'date-asc')  return (a.dataset.date || '').localeCompare(b.dataset.date || '');
				if (activeSort === 'rating')    return parseInt(b.dataset.rating || '0') - parseInt(a.dataset.rating || '0');
				if (activeSort === 'title')     return (a.dataset.title || '').localeCompare(b.dataset.title || '');
				return 0;
			});
			items.forEach(item => container.appendChild(item));
		});

		buildYearAnchors();
		update();
	}

	sortSelect?.addEventListener('change', () => {
		activeSort = sortSelect.value;
		applySort();
		applyFilters();
	});

	// ── Filter state
	let activeGenre    = 'all';
	let activeStatus   = 'reviewed';
	let activeAuthor   = '';
	let activeSubgenre = '';
	let activeRating   = '';
	let currentView    = 'grid';

	// ── Apply filters
	function applyFilters() {
		// Toggle is-hidden on every card (both grid and list copies share data attrs).
		document.querySelectorAll<HTMLElement>('.post-item').forEach(item => {
			const category  = item.dataset.category  || '';
			const author    = item.dataset.author    || '';
			const subgenres = item.dataset.subgenres || '';

			let show = true;

			if (activeGenre === 'fiction') {
				show = category === 'fiction';
			} else if (activeGenre === 'nonfiction') {
				show = category === 'nonfiction';
			}

			if (show && activeSubgenre) {
				show = subgenres.split('|').includes(activeSubgenre);
			}

			if (show && activeAuthor) {
				show = author === activeAuthor.toLowerCase();
			}

			if (show && activeStatus !== 'all') {
				show = (item.dataset.status || '') === activeStatus;
			}

			if (show && activeRating) {
				show = (item.dataset.rating || '') === activeRating;
			}

			item.classList.toggle('is-hidden', !show);
		});

		// Count visible from the grid only (never double-counts the list copy).
		const scope = gridEl || document;
		const visible = scope.querySelectorAll('.post-item:not(.is-hidden)').length;
		const visibleReviewed = scope.querySelectorAll('.post-item[data-status="reviewed"]:not(.is-hidden)').length;

		const countNum = document.getElementById('count-num');
		if (countNum) countNum.textContent = String(visible);
		const reviewedNum = document.getElementById('reviewed-num');
		if (reviewedNum) reviewedNum.textContent = String(visibleReviewed);

		const sheetCount = document.getElementById('fb-sheet-count');
		if (sheetCount) sheetCount.textContent = String(visible);
		updateSheetBadge();

		const noResults = document.getElementById('no-results');
		if (noResults) noResults.style.display = visible === 0 ? '' : 'none';

		buildYearAnchors();
		update();
	}

	// Count active (non-default) filters for the filter badges (sheet trigger + pill).
	function updateSheetBadge() {
		let n = 0;
		if (activeGenre !== 'all')      n++;
		if (activeSubgenre !== '')      n++;
		if (activeStatus !== 'reviewed') n++;
		if (activeAuthor !== '')        n++;
		['fb-sheet-badge', 'pill-filter-badge'].forEach(id => {
			const badge = document.getElementById(id);
			if (!badge) return;
			badge.textContent = String(n);
			(badge as HTMLElement).hidden = n === 0;
		});
	}

	// ── Segmented filters (genre + review status share the .fb-seg-btn look,
	// scoped by their container so the two groups don't clear each other).
	function setupSeg(containerId: string, onPick: (btn: HTMLButtonElement) => void) {
		const group = document.getElementById(containerId);
		if (!group) return;
		group.querySelectorAll<HTMLButtonElement>('.fb-seg-btn').forEach(btn => {
			btn.addEventListener('click', (e) => {
				group.querySelectorAll('.fb-seg-btn').forEach(b => b.classList.remove('is-on'));
				btn.classList.add('is-on');
				onPick(btn);
				applyFilters();
				// Only log real user clicks — URL-param preselects fire a synthetic .click().
				if (e.isTrusted) {
					const type = btn.dataset.genre !== undefined ? 'genre' : 'status';
					track('filter_reviews', { filter_type: type, filter_value: btn.dataset.genre ?? btn.dataset.status ?? 'all' });
				}
			});
		});
	}
	setupSeg('genre-seg',  btn => { activeGenre  = btn.dataset.genre  || 'all'; });
	setupSeg('status-seg', btn => { activeStatus = btn.dataset.status || 'all'; });

	// ── Generic combobox helper
	function setupCombo(
		comboEl: HTMLElement,
		btnEl: HTMLButtonElement,
		popEl: HTMLElement,
		listEl: HTMLElement,
		valueEl: HTMLElement,
		searchInput: HTMLInputElement,
		onSelect: (val: string) => void,
		trackType: string
	) {
		let selected = '';

		function open() {
			popEl.style.display = '';
			comboEl.classList.add('is-open');
			btnEl.setAttribute('aria-expanded', 'true');
			searchInput.value = '';
			filterOpts('');
			searchInput.focus();
		}
		function close() {
			popEl.style.display = 'none';
			comboEl.classList.remove('is-open');
			btnEl.setAttribute('aria-expanded', 'false');
		}
		function filterOpts(q: string) {
			const opts = listEl.querySelectorAll<HTMLElement>('.fb-combo-opt');
			const qLow = q.toLowerCase();
			let hasVisible = false;
			opts.forEach(opt => {
				const match = !qLow || (opt.textContent || '').toLowerCase().includes(qLow);
				opt.style.display = match ? '' : 'none';
				if (match) hasVisible = true;
			});
			let emptyEl = listEl.querySelector('.fb-combo-empty');
			if (!hasVisible) {
				if (!emptyEl) {
					emptyEl = document.createElement('div');
					emptyEl.className = 'fb-combo-empty';
					emptyEl.textContent = 'No results';
					listEl.appendChild(emptyEl);
				}
			} else {
				emptyEl?.remove();
			}
		}
		function select(val: string) {
			selected = val;
			const displayVal = val ? val.charAt(0).toUpperCase() + val.slice(1) : 'Any';
			valueEl.textContent = displayVal;
			comboEl.classList.toggle('has-value', !!val);
			listEl.querySelectorAll<HTMLElement>('.fb-combo-opt').forEach(opt => {
				const isOn = opt.dataset.author === val || opt.dataset.tag === val || opt.dataset.subgenre === val;
				opt.classList.toggle('is-on', isOn);
				const check = opt.querySelector<SVGElement>('.fb-combo-check');
				if (check) check.style.display = isOn ? '' : 'none';
			});
			onSelect(val);
			close();
		}

		btnEl.addEventListener('click', (e) => {
			if ((e.target as HTMLElement).closest('.fb-combo-x')) {
				select('');
				track('filter_reviews', { filter_type: trackType, filter_value: '' });
				return;
			}
			comboEl.classList.contains('is-open') ? close() : open();
		});
		searchInput.addEventListener('input', () => filterOpts(searchInput.value));
		listEl.addEventListener('click', (e) => {
			const opt = (e.target as HTMLElement).closest<HTMLButtonElement>('.fb-combo-opt');
			if (opt) {
				const val = opt.dataset.author || opt.dataset.tag || opt.dataset.subgenre || '';
				const newVal = selected === val ? '' : val;
				select(newVal);
				track('filter_reviews', { filter_type: trackType, filter_value: newVal });
			}
		});
		document.addEventListener('click', (e) => {
			if (!comboEl.contains(e.target as Node)) close();
		});

		// Expose select() so URL params can pre-apply a filter programmatically.
		return { select };
	}

	// Author combobox
	const authorCombo  = document.getElementById('author-combo') as HTMLElement;
	const authorBtn    = document.getElementById('author-combo-btn') as HTMLButtonElement;
	const authorPop    = document.getElementById('author-combo-pop') as HTMLElement;
	const authorList   = document.getElementById('author-combo-list') as HTMLElement;
	const authorVal    = document.getElementById('author-combo-value') as HTMLElement;
	const authorSearch = authorPop?.querySelector<HTMLInputElement>('.fb-combo-search')!;
	let authorApi: { select: (v: string) => void } | null = null;
	if (authorCombo) {
		authorApi = setupCombo(authorCombo, authorBtn, authorPop, authorList, authorVal, authorSearch, val => {
			activeAuthor = val;
			applyFilters();
		}, 'author');
	}

	// Subgenre combobox
	const subgenreCombo  = document.getElementById('subgenre-combo') as HTMLElement;
	const subgenreBtn    = document.getElementById('subgenre-combo-btn') as HTMLButtonElement;
	const subgenrePop    = document.getElementById('subgenre-combo-pop') as HTMLElement;
	const subgenreList   = document.getElementById('subgenre-combo-list') as HTMLElement;
	const subgenreVal    = document.getElementById('subgenre-combo-value') as HTMLElement;
	const subgenreSearch = subgenrePop?.querySelector<HTMLInputElement>('.fb-combo-search')!;
	let subgenreApi: { select: (v: string) => void } | null = null;
	if (subgenreCombo) {
		subgenreApi = setupCombo(subgenreCombo, subgenreBtn, subgenrePop, subgenreList, subgenreVal, subgenreSearch, val => {
			activeSubgenre = val;
			applyFilters();
		}, 'subgenre');
	}

	// ── View toggle
	const gridBtn = document.getElementById('view-grid') as HTMLButtonElement;
	const listBtn = document.getElementById('view-list') as HTMLButtonElement;

	function setView(view: string) {
		currentView = view;
		gridBtn.classList.toggle('is-on', view === 'grid');
		listBtn.classList.toggle('is-on', view === 'list');
		document.querySelectorAll<HTMLElement>('.view-grid').forEach(el => el.style.display = view === 'grid' ? '' : 'none');
		document.querySelectorAll<HTMLElement>('.view-list').forEach(el => el.style.display = view === 'list' ? '' : 'none');
	}
	gridBtn?.addEventListener('click', () => setView('grid'));
	listBtn?.addEventListener('click', () => setView('list'));

	// ── Collapse / show filters (single toggle that stays put; only the
	// controls collapse, the count + toggle button never move)
	const controls  = document.getElementById('fb-controls')!;
	const toggleBtn  = document.getElementById('fb-toggle-btn')!;
	let fbCollapsed = false;
	toggleBtn?.addEventListener('click', () => {
		fbCollapsed = !fbCollapsed;
		controls.style.display = fbCollapsed ? 'none' : '';
		toggleBtn.classList.toggle('is-collapsed', fbCollapsed);
		const lbl = fbCollapsed ? 'Show filters' : 'Hide filters';
		toggleBtn.setAttribute('aria-label', lbl);
		toggleBtn.setAttribute('title', lbl);
		update(); // refresh floating year-rail offset after height change
	});

	// ── Mobile filter bottom sheet
	const sheetTrigger  = document.getElementById('fb-sheet-trigger');
	const sheetBackdrop = document.getElementById('fb-sheet-backdrop');
	const sheetApply    = document.getElementById('fb-sheet-apply');
	const sheetReset    = document.getElementById('fb-sheet-reset');

	// On mobile the sheet must escape .filter-bar-wrap, whose backdrop-filter makes it the
	// containing block for position:fixed children (so `bottom:0` would anchor to the bar,
	// not the viewport). Portal #fb-controls to <body> on mobile; restore it on desktop.
	const sheetMq = window.matchMedia('(max-width: 720px)');
	const sheetHome = controls.parentNode;
	const sheetAnchor = controls.nextSibling;
	function syncSheetHome() {
		if (sheetMq.matches) {
			if (controls.parentNode !== document.body) document.body.appendChild(controls);
		} else if (controls.parentNode === document.body) {
			closeSheet();
			sheetHome?.insertBefore(controls, sheetAnchor);
		}
	}

	function openSheet() {
		controls.classList.add('is-open');
		if (sheetBackdrop) sheetBackdrop.hidden = false;
		// next frame so the backdrop transitions in
		requestAnimationFrame(() => sheetBackdrop?.classList.add('is-open'));
		sheetTrigger?.setAttribute('aria-expanded', 'true');
		document.body.style.overflow = 'hidden';
	}
	function closeSheet() {
		controls.classList.remove('is-open');
		sheetBackdrop?.classList.remove('is-open');
		if (sheetBackdrop) sheetBackdrop.hidden = true;
		sheetTrigger?.setAttribute('aria-expanded', 'false');
		document.body.style.overflow = '';
	}
	syncSheetHome();
	sheetMq.addEventListener('change', syncSheetHome);
	sheetTrigger?.addEventListener('click', openSheet);
	sheetApply?.addEventListener('click', closeSheet);
	sheetBackdrop?.addEventListener('click', closeSheet);
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && controls.classList.contains('is-open')) closeSheet();
	});
	sheetReset?.addEventListener('click', () => {
		subgenreApi?.select('');
		authorApi?.select('');
		document.querySelector<HTMLButtonElement>('#genre-seg .fb-seg-btn[data-genre="all"]')?.click();
		document.querySelector<HTMLButtonElement>('#status-seg .fb-seg-btn[data-status="reviewed"]')?.click();
		applyFilters();
	});

	// ── Mobile pill toolbar — filter / sort / view (reuses sheet, sort-select, setView)
	const pillFilter  = document.getElementById('pill-filter');
	const pillSort    = document.getElementById('pill-sort');
	const pillSortPop = document.getElementById('pill-sort-pop');
	const pillView    = document.getElementById('pill-view');

	pillFilter?.addEventListener('click', openSheet);

	function closeSortPop() {
		if (!pillSortPop) return;
		pillSortPop.hidden = true;
		pillSortPop.classList.remove('is-open');
		pillSort?.setAttribute('aria-expanded', 'false');
	}
	pillSort?.addEventListener('click', (e) => {
		e.stopPropagation();
		if (!pillSortPop) return;
		const open = pillSortPop.hidden;
		pillSortPop.hidden = !open;
		pillSortPop.classList.toggle('is-open', open);
		pillSort.setAttribute('aria-expanded', String(open));
	});
	pillSortPop?.querySelectorAll<HTMLButtonElement>('.pill-sort-opt').forEach(opt => {
		opt.addEventListener('click', () => {
			const val = opt.dataset.sort || 'date-desc';
			if (sortSelect) { sortSelect.value = val; sortSelect.dispatchEvent(new Event('change')); }
			pillSortPop.querySelectorAll('.pill-sort-opt').forEach(o => o.classList.toggle('is-on', o === opt));
			closeSortPop();
		});
	});
	document.addEventListener('click', (e) => {
		if (pillSortPop && !pillSortPop.hidden &&
			!pillSortPop.contains(e.target as Node) && !pillSort?.contains(e.target as Node)) closeSortPop();
	});
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && pillSortPop && !pillSortPop.hidden) closeSortPop();
	});

	pillView?.addEventListener('click', () => {
		setView(currentView === 'grid' ? 'list' : 'grid');
		pillView.classList.toggle('is-list', currentView === 'list');
	});

	// ── Pre-filter from URL params (e.g. header search → author / genre landing).
	// Coming-soon books are off by default ('reviewed'); a deep-link to an author
	// or genre flips to "Entire Shelf" so those books show too.
	const params = new URLSearchParams(location.search);
	const forceShelf = () =>
		document.querySelector<HTMLButtonElement>('#status-seg .fb-seg-btn[data-status="all"]')?.click();
	const paramAuthor = params.get('author');
	const paramSubgenre = params.get('subgenre');
	const paramCategory = params.get('category');
	const paramStatus = params.get('status');
	const paramRating = params.get('rating');
	if (paramStatus === 'all') { forceShelf(); }
	if (paramRating && /^[1-5]$/.test(paramRating)) { activeRating = paramRating; forceShelf(); }
	if (paramAuthor && authorApi) { authorApi.select(paramAuthor); forceShelf(); }
	if (paramSubgenre && subgenreApi) { subgenreApi.select(paramSubgenre.toLowerCase()); forceShelf(); }
	if (paramCategory === 'fiction' || paramCategory === 'nonfiction') {
		document.querySelector<HTMLButtonElement>(`#genre-seg .fb-seg-btn[data-genre="${paramCategory}"]`)?.click();
		forceShelf();
	}

	// Apply the default 'reviewed' filter on load
	applyFilters();

});
</script>
