---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
import PageMasthead from '../components/PageMasthead.astro';
import { computeStats } from '../utils/stats';
import { barsSVG } from '../utils/charts';
import { renderSpec, barsHeight, type ChartSpec } from '../utils/stats-charts';
import { CAT_COLORS, GENDER_COLORS } from '../utils/viz';

const s = computeStats();
const fmt = (n: number) => n.toLocaleString('en-US');
const compact = (n: number) => new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 }).format(n);
const toFlag = (iso: string) =>
	iso ? [...iso.toUpperCase()].map(c => String.fromCodePoint(0x1F1E6 + c.charCodeAt(0) - 65)).join('') : '🌍';
const top16Countries = s.countryStats.slice(0, 16);

const pct = (v: number, t: number) => (t ? Math.round((v / t) * 100) : 0);
const fiction = s.category[0].value;
const nonfiction = s.category[1].value;
const female = s.gender[0].value;
const male = s.gender[1].value;

// Headline figures.
const cards = [
	{ num: s.booksRead, label: 'Books read' },
	{ num: s.uniqueBooks, label: 'Unique books' },
	{ num: s.uniqueAuthors, label: 'Authors' },
	{ num: s.pagesRead, label: 'Pages read' },
	{ num: s.avgPagesPerDay, label: 'Pages / day' },
	{ num: s.yearsReading, label: 'Years reading' },
];

// In-page navigation — ids mirror the section anchors; the desktop rail and the mobile
// chip strip render from this single source so labels and order stay in sync.
const navItems = [
	{ id: 'overview', label: 'Overview' },
	{ id: 'over-time', label: 'Over time' },
	{ id: 'what-i-read', label: 'Makeup' },
	{ id: 'genres', label: 'Genres' },
	{ id: 'length', label: 'Length' },
	{ id: 'when-written', label: 'Era' },
	{ id: 'most-read', label: 'Authors' },
	{ id: 'geography', label: 'Geography' },
];

// Charts are described once as serialisable specs and rendered through the shared
// renderSpec() — server-side here (first paint / no-JS) and again client-side at each
// chart's real container width so SVG text stays crisp at any screen size (see the
// script below). Colour convention: counts/magnitudes use --viz-primary; averages
// use --viz-secondary; categorical splits draw from --viz-cat-* (see src/utils/viz.ts).
// Per-bar accents (hbars `colors`): rank-#1 in --ink; pub-era fades --viz-gray → rust at 1960.
const rankColors = (bars: { label: string }[]) =>
	bars.map((_, i) => (i === 0 ? 'var(--ink)' : 'var(--viz-primary)'));
const PRE_1960 = new Set(['BCE', '0–500', '500–1000', '1000–1500', '1500–1700', '1700–1900', '1900–29', '1930–59']);
const eraColors = s.pubEra.map((b) => (PRE_1960.has(b.label) ? 'var(--viz-gray)' : 'var(--viz-primary)'));
const chartSpecs: ChartSpec[] = [
	{ id: 'chart-rating', kind: 'curve', data: s.ratings, color: 'var(--viz-primary)', tick: 'stars', yTicks: 4, showValues: true,
		ariaLabel: 'Rating distribution, 1 to 5 stars', title: 'Rating distribution',
		desc: s.ratings.map((r) => `${r.label} star: ${r.value} books`).join(', ') },
	{ id: 'chart-genres', kind: 'hbars', data: s.genres.slice(0, 15), color: 'var(--viz-primary)', labelWRatio: 0.30, rowH: 30,
		ariaLabel: 'Books read by genre, top 15', title: 'Books by genre',
		desc: s.genres.slice(0, 15).map((g) => `${g.label}: ${g.value}`).join(', '), mobile: { maxRows: 10 } },
	{ id: 'chart-avg-rating-genre', kind: 'hbars', data: s.avgRatingByGenre, color: 'var(--viz-secondary)', value: 'rating1', labelWRatio: 0.30, rowH: 30,
		ariaLabel: 'Average rating by genre, highest first', title: 'Highest-rated genres',
		desc: s.avgRatingByGenre.map((g) => `${g.label}: ${g.value.toFixed(1)} stars`).join(', '), mobile: { maxRows: 8 } },
	{ id: 'chart-longest', kind: 'hbars', data: s.longestBooks, color: 'var(--viz-primary)', colors: rankColors(s.longestBooks), value: 'pp', labelWRatio: 0.42, rowH: 32,
		ariaLabel: 'Top 10 longest books read, by page count', title: 'Longest books read',
		desc: s.longestBooks.map((b) => `${b.label}: ${b.value} pages`).join(', ') },
	{ id: 'chart-length-dist', kind: 'bars', data: s.lengthDistribution, color: 'var(--viz-primary)', showValues: true,
		ariaLabel: 'Distribution of books by page count', title: 'Book length distribution',
		desc: s.lengthDistribution.map((b) => `${b.label} pages: ${b.value} books`).join(', ') },
	{ id: 'chart-avg-pages', kind: 'bars', data: s.avgPagesByYear, color: 'var(--viz-secondary)', showValues: true,
		ariaLabel: 'Average book length by year, in pages', title: 'Average book length by year',
		desc: s.avgPagesByYear.map((b) => `${b.label}: ${b.value} pages`).join(', '), mobile: { thin: 2, hideValues: true } },
	{ id: 'chart-pub-era', kind: 'hbars', data: s.pubEra, color: 'var(--viz-primary)', colors: eraColors, labelWRatio: 0.20, rowH: 30,
		ariaLabel: 'Books by era of original publication', title: 'Books by era of publication',
		desc: s.pubEra.map((b) => `${b.label}: ${b.value} books`).join(', ') },
	{ id: 'chart-authors', kind: 'hbars', data: s.topAuthors, color: 'var(--viz-primary)', colors: rankColors(s.topAuthors), labelWRatio: 0.34, rowH: 28,
		ariaLabel: 'Top 25 authors by number of books read', title: 'Most-read authors',
		desc: s.topAuthors.map((a) => `${a.label}: ${a.value}`).join(', '), mobile: { maxRows: 10 } },
	{ id: 'chart-languages', kind: 'hbars', data: s.topLanguages, color: 'var(--viz-primary)', labelWRatio: 0.28, rowH: 30,
		ariaLabel: 'Books by original language, top 12', title: 'Books by original language',
		desc: s.topLanguages.map((l) => `${l.label}: ${l.value}`).join(', ') },
	{ id: 'chart-cat-split', kind: 'split',
		data: [{ label: 'Fiction', value: fiction, color: CAT_COLORS[0] }, { label: 'Non-fiction', value: nonfiction, color: CAT_COLORS[1] }],
		ariaLabel: `Fiction ${pct(fiction, fiction + nonfiction)}%, non-fiction ${pct(nonfiction, fiction + nonfiction)}%`, title: 'Fiction vs non-fiction' },
	{ id: 'chart-gender-split', kind: 'split',
		data: [{ label: 'Female', value: female, color: GENDER_COLORS[0] }, { label: 'Male', value: male, color: GENDER_COLORS[1] }],
		ariaLabel: `Female authors ${pct(female, female + male)}%, male authors ${pct(male, female + male)}%`, title: 'Author gender' },
];

// Per-metric datasets the Books ⇄ Pages toggles swap into the genre/author charts in
// place (mirrors longestBooksByCategory). Books is the default/SSR view.
const genreMetric = { books: s.genres.slice(0, 15), pages: s.genresByPages.slice(0, 15) };
const authorMetric = { books: s.topAuthors, pages: s.topAuthorsByPages };

// Default server-render width; the client re-renders each chart to its real container px.
const SSR_W = 920;
const ssr: Record<string, string> = Object.fromEntries(chartSpecs.map((sp) => [sp.id, renderSpec(sp, SSR_W, false)]));

const initialTimeline = barsSVG(s.timeline.year.books, {
	width: SSR_W, height: barsHeight(SSR_W, false), color: 'var(--viz-primary)', showValues: true,
	ariaLabel: 'Books read by year', title: 'Books read by year',
	desc: s.timeline.year.books.map((b) => `${b.label}: ${b.value}`).join(', '),
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Stats — ${SITE_TITLE}`} description={`A decade of reading by the numbers: ${fmt(s.booksRead)} books, ${fmt(s.pagesRead)} pages, ${s.firstYear}–${s.lastYear}.`} ogImage="/og/stats.png" />
	</head>
	<body>
		<Header />

		<!-- Scroll-progress bar (fills as the page scrolls) -->
		<div class="scroll-progress" id="scroll-progress" aria-hidden="true"><span></span></div>

		<!-- Desktop section rail (scroll-spy) -->
		<nav class="stats-rail" id="stats-rail" aria-label="Page sections">
			<ul>
				{navItems.map((n, i) => (
					<li>
						<a href={`#${n.id}`} data-rail={n.id}>
							<span class="rail-label">{n.label}</span>
							<span class="rail-num">{String(i + 1).padStart(2, '0')}</span>
						</a>
					</li>
				))}
			</ul>
		</nav>

		<main class="stats-page">

			<!-- Hero -->
			<PageMasthead
				eyebrow="Reading stats"
				title="Keeping track of my habits"
				lede={`${fmt(s.booksRead)} books over ${s.yearsReading} years, and counting.`}
			/>

			<!-- Mobile section chips (sticky under header) -->
			<nav class="stats-chips" id="stats-chips" aria-label="Page sections">
				<div class="chips-track">
					{navItems.map((n) => (
						<a href={`#${n.id}`} data-chip={n.id}>{n.label}</a>
					))}
				</div>
			</nav>

			<!-- Headline cards -->
			<section id="overview" class="section stats-section">
				<div class="bleed">
					<div class="stat-grid">
						{cards.map((c) => (
							<div class="stat-card">
								<div class="stat-num" data-count={c.num} data-fmt="compact">{compact(c.num)}</div>
								<div class="stat-label">{c.label}</div>
							</div>
						))}
					</div>
				</div>
			</section>

			<!-- Reading over time (interactive) -->
			<section id="over-time" class="section stats-section">
				<div class="bleed">
					<div class="section-head">
						<div>
							<p class="index-num">§ OVER TIME</p>
							<h2>Reading over time</h2>
						</div>
					</div>

					<div class="chart-card">
						<div class="controls-wrap">
						<div class="chart-head">
							<p class="chart-title" id="timeline-title">Books read</p>
							<button class="controls-toggle" id="timeline-filter-btn" type="button" aria-expanded="false" aria-controls="timeline-controls">
								<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
									<path d="M2 4h10M3.5 7h7M5 10h4"/>
								</svg>
								<span>Filter</span>
							</button>
						</div>
						<div class="controls" id="timeline-controls">
							<div class="control-group">
								<span class="fb-label">Show</span>
								<div class="fb-seg" id="metric-seg" role="group" aria-label="Metric">
									<button class="fb-seg-btn is-on" data-metric="books">Books</button>
									<button class="fb-seg-btn" data-metric="pages">Pages</button>
									<button class="fb-seg-btn" data-metric="pagesPerDay">Pages / day</button>
								</div>
							</div>
							<div class="control-group">
								<span class="fb-label">By</span>
								<div class="fb-seg" id="gran-seg" role="group" aria-label="Granularity">
									<button class="fb-seg-btn" data-gran="month">Month</button>
									<button class="fb-seg-btn is-on" data-gran="year">Year</button>
								</div>
							</div>
							<div class="control-group">
								<span class="fb-label">Split</span>
								<div class="fb-seg" id="split-seg" role="group" aria-label="Split (books or pages)">
									<button class="fb-seg-btn is-on" data-split="none">Total</button>
									<button class="fb-seg-btn" data-split="category">Fiction / Non</button>
									<button class="fb-seg-btn" data-split="gender">Author gender</button>
								</div>
							</div>
						</div>
						</div>

						<p class="chart-sub" id="timeline-sub">By year</p>
						<div class="legend" id="timeline-legend" aria-hidden="true"></div>
						<div class="chart-holder" id="timeline-chart" set:html={initialTimeline} />
					</div>
				</div>
			</section>

			<!-- Composition -->
			<section id="what-i-read" class="section stats-section">
				<div class="bleed">
					<div class="section-head">
						<div>
							<p class="index-num">§ WHAT I READ</p>
							<h2>The makeup of the shelf</h2>
						</div>
					</div>

					<div class="comp">
						<div class="chart-card">
							<p class="chart-title">Fiction vs non-fiction</p>
							<p class="chart-sub">{s.uniqueBooks} books</p>
							<div class="split-holder" id="chart-cat-split" set:html={ssr['chart-cat-split']} />
							<div class="legend legend--counts">
								<span class="legend-item"><span class="legend-sw" style={`background:${CAT_COLORS[0]}`}></span>Fiction · {fmt(fiction)} ({pct(fiction, fiction + nonfiction)}%)</span>
								<span class="legend-item"><span class="legend-sw" style={`background:${CAT_COLORS[1]}`}></span>Non-fiction · {fmt(nonfiction)} ({pct(nonfiction, fiction + nonfiction)}%)</span>
							</div>
						</div>

						<div class="chart-card">
							<p class="chart-title">Authors by gender</p>
							<p class="chart-sub">{s.uniqueBooks} books</p>
							<div class="split-holder" id="chart-gender-split" set:html={ssr['chart-gender-split']} />
							<div class="legend legend--counts">
								<span class="legend-item"><span class="legend-sw" style={`background:${GENDER_COLORS[0]}`}></span>Women · {fmt(female)} ({pct(female, female + male)}%)</span>
								<span class="legend-item"><span class="legend-sw" style={`background:${GENDER_COLORS[1]}`}></span>Men · {fmt(male)} ({pct(male, female + male)}%)</span>
							</div>
						</div>

						<div class="chart-card span-2">
							<p class="chart-title">How I rate</p>
							<p class="chart-sub">Distribution of {fmt(s.ratings.reduce((a, r) => a + r.value, 0))} star ratings</p>
							<div class="rating-holder" id="chart-rating" set:html={ssr['chart-rating']} />
						</div>
					</div>
				</div>
			</section>

			<!-- Genres -->
			<section id="genres" class="section stats-section">
				<div class="bleed">
					<div class="section-head">
						<div>
							<p class="index-num">§ GENRES</p>
							<h2>Books by genre</h2>
						</div>
					</div>
					<div class="chart-card">
						<div class="chart-head">
							<p class="chart-title">Most-read genres</p>
							<div class="fb-seg" id="genres-metric-seg" role="group" aria-label="Genre metric">
								<button class="fb-seg-btn is-on" data-metric="books">Books</button>
								<button class="fb-seg-btn" data-metric="pages">Pages</button>
							</div>
						</div>
						<p class="chart-sub" id="genres-sub">Top 15 by books read</p>
						<div class="rank-holder" id="chart-genres" set:html={ssr['chart-genres']} />
					</div>
					{s.avgRatingByGenre.length > 0 && (
						<div class="chart-card" style="margin-top: clamp(16px, 2.2vw, 24px)">
							<p class="chart-title">Highest-rated genres</p>
							<p class="chart-sub">Mean rating · genres with 8+ books</p>
							<div class="rank-holder" id="chart-avg-rating-genre" set:html={ssr['chart-avg-rating-genre']} />
						</div>
					)}
				</div>
			</section>

			<!-- How long the books run -->
			<section id="length" class="section stats-section">
				<div class="bleed">
					<div class="section-head">
						<div>
							<p class="index-num">§ LENGTH</p>
							<h2>How long the books run</h2>
						</div>
					</div>
					<div class="chart-card">
						<div class="controls-wrap">
						<div class="chart-head">
							<p class="chart-title">Longest books read</p>
							<button class="controls-toggle" id="longest-filter-btn" type="button" aria-expanded="false" aria-controls="longest-controls">
								<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
									<path d="M2 4h10M3.5 7h7M5 10h4"/>
								</svg>
								<span>Filter</span>
							</button>
						</div>
						<div class="controls" id="longest-controls">
							<div class="control-group">
								<span class="fb-label">Show</span>
								<div class="fb-seg" id="longest-seg" role="group" aria-label="Longest books category">
									<button class="fb-seg-btn is-on" data-cat="all">All</button>
									<button class="fb-seg-btn" data-cat="fiction">Fiction</button>
									<button class="fb-seg-btn" data-cat="nonfiction">Non-fiction</button>
								</div>
							</div>
						</div>
						</div>
						<p class="chart-sub">Top 10 by page count</p>
						<div class="rank-holder" id="chart-longest" set:html={ssr['chart-longest']} />
					</div>
					<div class="chart-card" style="margin-top: clamp(16px, 2.2vw, 24px)">
						<p class="chart-title">Book length distribution</p>
						<p class="chart-sub">{fmt(s.lengthDistribution.reduce((a, b) => a + b.value, 0))} books by page count</p>
						<div class="chart-holder" id="chart-length-dist" set:html={ssr['chart-length-dist']} />
					</div>
					<div class="chart-card" style="margin-top: clamp(16px, 2.2vw, 24px)">
						<p class="chart-title">Average book length by year</p>
						<p class="chart-sub">Mean pages per book</p>
						<div class="chart-holder" id="chart-avg-pages" set:html={ssr['chart-avg-pages']} />
					</div>
				</div>
			</section>

			<!-- When the books were written -->
			<section id="when-written" class="section stats-section">
				<div class="bleed">
					<div class="section-head">
						<div>
							<p class="index-num">§ WHEN WRITTEN</p>
							<h2>When the books were written</h2>
						</div>
					</div>
					<div class="chart-card">
						<p class="chart-title">Books by era of publication</p>
						<p class="chart-sub">Original publication year · {fmt(s.pubEra.reduce((a, b) => a + b.value, 0))} books</p>
						<div class="rank-holder" id="chart-pub-era" set:html={ssr['chart-pub-era']} />
					</div>
				</div>
			</section>

			<!-- Most-read authors -->
			<section id="most-read" class="section stats-section">
				<div class="bleed">
					<div class="section-head">
						<div>
							<p class="index-num">§ MOST READ</p>
							<h2>Top 25 authors</h2>
						</div>
					</div>
					<div class="chart-card">
						<div class="chart-head">
							<p class="chart-title">Most-read authors</p>
							<div class="fb-seg" id="authors-metric-seg" role="group" aria-label="Author metric">
								<button class="fb-seg-btn is-on" data-metric="books">Books</button>
								<button class="fb-seg-btn" data-metric="pages">Pages</button>
							</div>
						</div>
						<p class="chart-sub" id="authors-sub">Top 25 by books read</p>
						<div class="rank-holder" id="chart-authors" set:html={ssr['chart-authors']} />
					</div>
				</div>
			</section>

			<!-- Reading by geography -->
			<section id="geography" class="section stats-section">
				<div class="bleed">
					<div class="section-head">
						<div>
							<p class="index-num">§ GEOGRAPHY</p>
							<h2>Where the authors come from</h2>
						</div>
					</div>
					<div class="chart-card">
						<p class="chart-title">Books by country of origin</p>
						<p class="chart-sub">{s.countryStats.length} countries · {s.uniqueBooks} books</p>
						<div id="world-map" class="world-map" aria-label="World map showing books read by country of origin">
							<p class="world-map-loading">Loading map…</p>
						</div>
					</div>
					<div class="chart-card" style="margin-top: clamp(16px, 2.2vw, 24px)">
						<p class="chart-title">Top 16 countries</p>
						<p class="chart-sub">By books read</p>
						<div class="flag-grid">
							{top16Countries.map(c => (
								<div class="flag-card">
									<span class="flag-emoji">{toFlag(c.isoCode)}</span>
									<span class="flag-name">{c.country}</span>
									<span class="flag-count">{c.books}</span>
								</div>
							))}
						</div>
					</div>
					<div class="chart-card" style="margin-top: clamp(16px, 2.2vw, 24px)">
						<p class="chart-title">Books by original language</p>
						<p class="chart-sub">{s.languageStats.filter((l) => l.language !== 'English').reduce((a, l) => a + l.books, 0)} of {s.uniqueBooks} books read in translation</p>
						<div class="rank-holder" id="chart-languages" set:html={ssr['chart-languages']} />
					</div>
				</div>
			</section>

		</main>
		<Footer />

		<button class="back-to-top" id="back-to-top" aria-label="Back to top">
			<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
				<path d="M7 11.5V2.5"/><path d="M3 6.5l4-4 4 4"/>
			</svg>
		</button>

		<script type="application/json" id="stats-timeline" set:html={JSON.stringify(s.timeline)} />
		<script type="application/json" id="stats-charts" set:html={JSON.stringify(chartSpecs)} />
		<script type="application/json" id="stats-longest" set:html={JSON.stringify(s.longestBooksByCategory)} />
		<script type="application/json" id="stats-genre-metric" set:html={JSON.stringify(genreMetric)} />
		<script type="application/json" id="stats-author-metric" set:html={JSON.stringify(authorMetric)} />
		<script type="application/json" id="stats-countries" set:html={JSON.stringify(s.countryStats)} />
	</body>
</html>

<style>
.stats-page { padding-top: clamp(8px, 2vw, 24px); padding-bottom: clamp(40px, 6vw, 80px); overflow-x: clip; }
.stats-section { padding-top: clamp(40px, 5vw, 72px); padding-bottom: 0; }
.stats-section:first-of-type { padding-top: clamp(28px, 3vw, 44px); }

/* Headline cards */
.stat-grid {
	display: grid;
	grid-template-columns: repeat(2, 1fr);
	gap: clamp(12px, 1.6vw, 20px);
}
@media (min-width: 760px) {
	.stat-grid { grid-template-columns: repeat(3, 1fr); }
}
.stat-card {
	background: #faf6ec;
	border: 1px solid rgba(26, 22, 20, 0.08);
	border-radius: 0;
	padding: clamp(18px, 2.2vw, 28px);
}
.stat-num {
	font-family: var(--serif);
	font-weight: 400;
	font-size: clamp(34px, 4.4vw, 54px);
	line-height: 1;
	letter-spacing: -0.03em;
	color: var(--accent-2);
}
.stat-label {
	font-family: var(--mono);
	font-size: 11px;
	letter-spacing: 0.18em;
	text-transform: uppercase;
	color: var(--muted);
	margin-top: 12px;
}

/* Chart cards */
.chart-card {
	background: var(--paper);
	border: 1px solid var(--rule);
	border-radius: 4px;
	padding: clamp(18px, 2.4vw, 32px);
}
.chart-title { font-family: var(--sans); font-weight: 500; font-size: 15px; color: var(--ink); margin: 0; }
.chart-sub {
	font-family: var(--mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
	color: var(--muted); margin: 4px 0 18px;
}
.chart-holder { width: 100%; }
.rank-holder, .rating-holder, .split-holder { width: 100%; }

/* Flag grid */
.flag-grid {
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	gap: clamp(8px, 1.2vw, 12px);
	margin-top: clamp(14px, 1.8vw, 20px);
}
@media (max-width: 540px) {
	/* Compact horizontal rows so the 16-country grid isn't a tall scroll: flag · name · count. */
	.flag-grid { grid-template-columns: repeat(2, 1fr); gap: 8px; }
	.flag-card { flex-direction: row; align-items: center; gap: 8px; padding: 8px 10px; text-align: left; }
	.flag-emoji { font-size: 20px; }
	.flag-name { flex: 1; min-width: 0; font-size: 11px; }
	.flag-count { margin-left: auto; font-size: 15px; }
}
.flag-card {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 4px;
	padding: clamp(10px, 1.4vw, 16px) 8px;
	background: var(--paper);
	border: 1px solid var(--rule);
	border-radius: 4px;
	text-align: center;
}
.flag-emoji { font-size: clamp(28px, 4vw, 40px); line-height: 1.1; }
.flag-name {
	font-family: var(--sans);
	font-size: clamp(10px, 1.1vw, 12px);
	color: var(--ink-2);
	line-height: 1.2;
}
.flag-count {
	font-family: var(--serif);
	font-size: clamp(15px, 1.8vw, 20px);
	color: var(--viz-primary);
	line-height: 1;
}
.split-holder { border-radius: 3px; overflow: hidden; }

/* Controls */
.controls-wrap { display: flex; flex-direction: column; }
.chart-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.controls { display: flex; flex-wrap: wrap; gap: clamp(14px, 2vw, 28px); align-items: center; margin-bottom: 22px; order: -1; }
.control-group { display: flex; align-items: center; gap: 10px; min-width: 0; }
.fb-seg.is-disabled { opacity: 0.4; pointer-events: none; }

/* Mobile-only "Filter" toggle that collapses the timeline controls (hidden on desktop) */
.controls-toggle {
	display: none;
	align-items: center;
	gap: 8px;
	padding: 8px 14px;
	font-family: var(--sans);
	font-size: 12px;
	letter-spacing: 0.02em;
	color: var(--ink-2);
	background: var(--paper);
	border: 1px solid var(--rule);
	border-radius: 999px;
	cursor: pointer;
}
.controls-toggle svg { flex: none; }
.controls-toggle.is-on { background: var(--ink); color: var(--bg); border-color: var(--ink); }

/* Legend */
.legend { display: flex; flex-wrap: wrap; gap: 16px 22px; min-height: 18px; margin-bottom: 14px; }
.legend--counts { margin-top: 16px; margin-bottom: 0; }
.legend-item { display: inline-flex; align-items: center; gap: 8px; font-family: var(--sans); font-size: 13px; color: var(--ink-2); }
.legend-sw { width: 12px; height: 12px; border-radius: 3px; display: inline-block; flex: none; }

/* Composition grid */
.comp { display: grid; gap: clamp(16px, 2.2vw, 24px); grid-template-columns: 1fr; }
@media (min-width: 760px) {
	.comp { grid-template-columns: 1fr 1fr; }
	.comp .span-2 { grid-column: 1 / -1; }
}

/* World map */
.world-map {
	width: 100%;
	background: var(--bg);             /* ocean / no-data = page bg */
	border-radius: 3px;
	overflow: hidden;
	position: relative;
	--map-land: #e4ddd1;              /* countries with 0 books */
	--map-border: rgba(22,19,16,0.15);
	--map-accent: var(--viz-primary); /* choropleth ceiling — rust */
}
.world-map svg { display: block; width: 100%; height: auto; }
.world-map-loading {
	position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
	font-family: var(--mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
	color: var(--muted); margin: 0;
}

.footnote {
	font-family: var(--sans); font-size: 13px; line-height: 1.65; color: var(--muted);
	max-width: 74ch; margin: clamp(26px, 3.4vw, 44px) 0 0; padding-top: 18px; border-top: 1px solid var(--rule);
}
.footnote strong { color: var(--ink-2); font-weight: 600; }

/* Mobile: stack the timeline controls into labeled, full-width segmented groups so
   nothing overflows the viewport (the global .fb-* mobile rules target the reviews
   filter bar, not these wrappers). */
@media (max-width: 640px) {
	.controls-toggle { display: inline-flex; }
	.controls { display: none; order: 0; flex-direction: column; align-items: stretch; gap: 14px; margin-top: 14px; }
	.controls.is-open { display: flex; }
	.control-group { flex-direction: column; align-items: stretch; gap: 6px; }
	.controls .fb-label { display: block; }
	.fb-seg { width: 100%; }
	.fb-seg-btn { flex: 1; text-align: center; min-height: 38px; }
}

/* ══════════════════════════════════════════════════════════════════════════
   In-page navigation — scroll-progress bar, desktop rail, mobile chips.
   ══════════════════════════════════════════════════════════════════════════ */
/* Each section clears the fixed 48px header (+ progress, + sticky chips on mobile). */
.stats-section { scroll-margin-top: 70px; }

.scroll-progress {
	position: fixed; top: 48px; left: 0; right: 0; height: 3px;
	z-index: 190; background: transparent; pointer-events: none;
}
.scroll-progress span {
	display: block; height: 100%; width: 100%;
	background: var(--viz-primary); transform: scaleX(0); transform-origin: left;
	transition: transform 90ms linear;
}

/* Desktop rail: a slim column of §-numbers in the right gutter (active number rust). The
   label is a floating pill shown ON HOVER ONLY, expanding leftward (the number is the
   right-anchored element) so the rail stays tidy inside the narrow full-bleed gutter and
   never floats a pill over the content/card edge at rest. */
.stats-rail { display: none; }
@media (min-width: 1100px) {
	.stats-rail { display: block; position: fixed; right: 14px; top: 50%; transform: translateY(-50%); z-index: 90; }
}
.stats-rail ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
.stats-rail a {
	display: flex; align-items: center; justify-content: flex-end; gap: 9px;
	padding: 3px 2px; text-decoration: none;
}
.stats-rail .rail-label {
	font-family: var(--sans); font-size: 12px; white-space: nowrap; color: var(--ink-2);
	background: var(--paper); border: 1px solid var(--rule); border-radius: 999px; padding: 3px 11px;
	opacity: 0; transform: translateX(6px); pointer-events: none;
	box-shadow: 0 6px 18px -10px rgba(0,0,0,0.3);
	transition: opacity 160ms ease, transform 160ms ease;
}
.stats-rail .rail-num {
	font-family: var(--mono); font-size: 10px; letter-spacing: 0.04em; color: var(--muted);
	width: 16px; text-align: right; transition: color 160ms ease;
}
.stats-rail a:hover .rail-label { opacity: 1; transform: translateX(0); }
.stats-rail a:hover .rail-num { color: var(--ink-2); }
.stats-rail a.is-active .rail-num { color: var(--viz-primary); font-size: 11px; }

/* Mobile chips: full-bleed sticky strip under the header, horizontally scrollable. */
.stats-chips {
	display: none; position: sticky; top: 51px; z-index: 100;
	background: var(--bg); border-bottom: 1px solid var(--rule);
}
@media (max-width: 1099px) { .stats-chips { display: block; } }
.chips-track {
	display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none;
	padding: 9px var(--bleed-gutter); -webkit-overflow-scrolling: touch;
}
.chips-track::-webkit-scrollbar { display: none; }
.stats-chips a {
	flex: none; white-space: nowrap; text-decoration: none;
	font-family: var(--sans); font-size: 12.5px; color: var(--ink-2);
	padding: 6px 13px; border: 1px solid var(--rule); border-radius: 999px;
	transition: background 160ms, color 160ms, border-color 160ms;
}
.stats-chips a.is-active { background: var(--ink); color: var(--bg); border-color: var(--ink); }
@media (max-width: 1099px) { .stats-section { scroll-margin-top: 104px; } }

/* ══════════════════════════════════════════════════════════════════════════
   Chart entrance / replay animations.

   Base (no .play) = final/natural state, so SSR, no-JS and post-resize all render
   correct, complete charts. JS adds .play to a holder to play (or replay, on toggle)
   the grow. The injected SVG isn't Astro-scoped, so its internals need :global().
   --bar-t (0→1 across the set, baked into each bar by charts.ts) drives the stagger.
   ══════════════════════════════════════════════════════════════════════════ */
@keyframes statGrowY { from { transform: scaleY(0.0001); } to { transform: scaleY(1); } }
@keyframes statGrowX { from { transform: scaleX(0.0001); } to { transform: scaleX(1); } }
@keyframes statFade  { from { opacity: 0; } to { opacity: 1; } }
@keyframes statDraw  { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }

/* Armed (pre-entrance) rest state — JS adds .arm to each holder until it scrolls into view,
   so the entrance plays a clean empty→fill instead of snapping a filled chart back to empty
   first (the "unfill then fill" flash, worst on the short split bars). */
.chart-holder.arm:not(.is-stacked) :global(svg rect) {
	transform-box: fill-box; transform-origin: bottom; transform: scaleY(0.0001);
}
.rank-holder.arm :global(svg rect) {
	transform-box: fill-box; transform-origin: left; transform: scaleX(0.0001);
}
.split-holder.arm :global(svg rect),
.chart-holder.arm.is-stacked :global(svg rect),
.rating-holder.arm :global(svg path),
.rating-holder.arm :global(svg circle) { opacity: 0; }

/* Stagger over a fixed time window (--bar-t is 0→1 across the set), so a 13-bar yearly
   chart and a ~150-bar monthly chart both finish in ~the same short span. */
/* Vertical bars grow up from the baseline. */
.chart-holder.play:not(.is-stacked) :global(svg rect) {
	transform-box: fill-box; transform-origin: bottom;
	animation: statGrowY 0.5s cubic-bezier(0.22, 1, 0.36, 1) backwards;
	animation-delay: calc(var(--bar-t, 0) * 440ms);
}
/* Stacked timeline bars fade column-by-column (scaling would gap the segments). */
.chart-holder.play.is-stacked :global(svg rect) {
	animation: statFade 0.45s ease-out backwards;
	animation-delay: calc(var(--bar-t, 0) * 380ms);
}
/* Horizontal ranking bars grow from the left. */
.rank-holder.play :global(svg rect) {
	transform-box: fill-box; transform-origin: left;
	animation: statGrowX 0.5s cubic-bezier(0.22, 1, 0.36, 1) backwards;
	animation-delay: calc(var(--bar-t, 0) * 440ms);
}
/* Split composition bars fade in (a single bar can't grow-from-left without gapping its
   two segments — like the stacked bars). */
.split-holder.play :global(svg rect) {
	animation: statFade 0.5s ease-out backwards;
	animation-delay: calc(var(--bar-t, 0) * 120ms);
}
/* Rating curve: area + points fade in, the line draws itself. */
.rating-holder.play :global(svg path:not([pathLength])),
.rating-holder.play :global(svg circle) {
	animation: statFade 0.6s ease-out backwards;
}
.rating-holder.play :global(svg circle) { animation-delay: 0.34s; }
.rating-holder.play :global(svg path[pathLength]) {
	stroke-dasharray: 1;
	animation: statDraw 0.9s ease-out backwards, statFade 0.3s ease-out backwards;
}

/* ── Respect reduced motion: no count-up/grow/draw; everything renders final. ── */
@media (prefers-reduced-motion: reduce) {
	.scroll-progress span { transition: none; }
	.chart-holder.play :global(svg rect),
	.rank-holder.play :global(svg rect),
	.split-holder.play :global(svg rect),
	.rating-holder.play :global(svg path),
	.rating-holder.play :global(svg circle) { animation: none; }
}
</style>

<script>
import { barsSVG, stackedBarsSVG } from '../utils/charts';
import { renderSpec, barsHeight, type ChartSpec } from '../utils/stats-charts';
import { thinTicks } from '../utils/chart-format';
import { CAT_COLORS, GENDER_COLORS } from '../utils/viz';
import { track } from '../utils/analytics';

const META: Record<string, string> = { books: 'Books read', pages: 'Pages read', pagesPerDay: 'Pages per day' };
const MOBILE = window.matchMedia('(max-width: 640px)');
const isMobile = () => MOBILE.matches;
const widthOf = (el: HTMLElement) => Math.round(el.clientWidth) || 600;
const motionOK = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

// Add (or restart) a holder's entrance "grow", then drop the class once it finishes so
// later re-renders (e.g. on resize) don't replay it — only a fresh scroll-in or toggle does.
function playGrow(holder: HTMLElement | null) {
	if (!holder || !motionOK) return;
	holder.classList.remove('play');
	void holder.offsetWidth; // force reflow so the CSS animation restarts from zero
	holder.classList.add('play');
	clearTimeout((holder as unknown as { _playT?: number })._playT);
	(holder as unknown as { _playT?: number })._playT = window.setTimeout(() => holder.classList.remove('play'), 1600);
}

document.addEventListener('DOMContentLoaded', () => {
	// ── Static charts: re-render each to its container width (crisp text on any screen) ──
	const specsEl = document.getElementById('stats-charts');
	const specs: ChartSpec[] = specsEl ? JSON.parse(specsEl.textContent || '[]') : [];
	function renderStatic() {
		const mobile = isMobile();
		for (const spec of specs) {
			const holder = document.getElementById(spec.id);
			if (holder) holder.innerHTML = renderSpec(spec, widthOf(holder), mobile);
		}
	}

	// ── Interactive timeline ──
	const dataEl = document.getElementById('stats-timeline');
	const chartEl = document.getElementById('timeline-chart');
	const titleEl = document.getElementById('timeline-title');
	const subEl = document.getElementById('timeline-sub');
	const legendEl = document.getElementById('timeline-legend');
	const timeline = dataEl ? JSON.parse(dataEl.textContent || '{}') : null;
	let gran: 'month' | 'year' = 'year';
	let metric: 'books' | 'pages' | 'pagesPerDay' = 'books';
	let split: 'none' | 'category' | 'gender' = 'none';

	function renderLegend(kind: 'category' | 'gender' | null) {
		if (!legendEl) return;
		if (!kind) { legendEl.innerHTML = ''; legendEl.setAttribute('aria-hidden', 'true'); return; }
		const items = kind === 'category'
			? [['Fiction', CAT_COLORS[0]], ['Non-fiction', CAT_COLORS[1]]]
			: [['Women', GENDER_COLORS[0]], ['Men', GENDER_COLORS[1]]];
		legendEl.innerHTML = items
			.map(([l, c]) => `<span class="legend-item"><span class="legend-sw" style="background:${c}"></span>${l}</span>`)
			.join('');
		legendEl.setAttribute('aria-hidden', 'false');
	}

	function renderTimeline() {
		if (!chartEl || !titleEl || !subEl || !timeline) return;
		const mobile = isMobile();
		const g = timeline[gran];
		const granLabel = gran === 'year' ? 'By year' : 'By month';
		let tickFmt = gran === 'month'
			? (l: string) => (l.endsWith('-01') ? l.slice(0, 4) : '')
			: (l: string) => l;
		if (mobile && gran === 'year') tickFmt = thinTicks(tickFmt, 2);
		const W = widthOf(chartEl);
		const showValues = gran === 'year' && !mobile;
		const baseOpts = { width: W, height: barsHeight(W, mobile), formatTick: tickFmt, showValues };

		if ((metric === 'books' || metric === 'pages') && split !== 'none') {
			const byCat = metric === 'pages' ? g.byCategoryPages : g.byCategory;
			const byGen = metric === 'pages' ? g.byGenderPages : g.byGender;
			const data = split === 'category' ? byCat : byGen;
			const colors = split === 'category' ? CAT_COLORS : GENDER_COLORS;
			const label = split === 'category' ? 'type' : 'author gender';
			chartEl.innerHTML = stackedBarsSVG(data, { ...baseOpts, colors, showTotals: showValues, ariaLabel: `${META[metric]} ${granLabel.toLowerCase()}, split by ${label}` });
			subEl.textContent = `${granLabel} · split by ${label}`;
			renderLegend(split as 'category' | 'gender');
		} else {
			chartEl.innerHTML = barsSVG(g[metric], { ...baseOpts, color: 'var(--viz-primary)', ariaLabel: `${META[metric]} ${granLabel.toLowerCase()}` });
			subEl.textContent = granLabel;
			renderLegend(null);
		}
		// Stacked bars fade (see CSS) instead of growing, so flag the holder accordingly.
		chartEl.classList.toggle('is-stacked', (metric === 'books' || metric === 'pages') && split !== 'none');
		titleEl.textContent = META[metric];
	}

	function syncSplitState() {
		const splitSeg = document.getElementById('split-seg');
		if (!splitSeg) return;
		const disabled = metric === 'pagesPerDay'; // split applies to books & pages, not pages/day
		splitSeg.classList.toggle('is-disabled', disabled);
		splitSeg.querySelectorAll<HTMLButtonElement>('.fb-seg-btn').forEach((b) => { b.disabled = disabled; });
		if (disabled && split !== 'none') {
			split = 'none';
			splitSeg.querySelectorAll('.fb-seg-btn').forEach((b) =>
				(b as HTMLElement).classList.toggle('is-on', (b as HTMLElement).dataset.split === 'none'));
		}
	}

	function setupSeg(id: string, onPick: (btn: HTMLElement) => void) {
		const group = document.getElementById(id);
		if (!group) return;
		group.querySelectorAll<HTMLButtonElement>('.fb-seg-btn').forEach((btn) => {
			btn.addEventListener('click', (e) => {
				if (btn.disabled) return;
				group.querySelectorAll('.fb-seg-btn').forEach((b) => b.classList.remove('is-on'));
				btn.classList.add('is-on');
				onPick(btn);
				if (e.isTrusted) {
					const value = btn.dataset.metric ?? btn.dataset.gran ?? btn.dataset.split ?? btn.dataset.cat ?? '';
					track('stats_control', { control: id, value });
				}
			});
		});
	}

	// Mobile: collapse a card's controls behind a "Filter" button that expands inline.
	function setupFilterToggle(btnId: string, controlsId: string) {
		const btn = document.getElementById(btnId);
		const ctrl = document.getElementById(controlsId);
		if (!btn || !ctrl) return;
		btn.addEventListener('click', () => {
			const open = ctrl.classList.toggle('is-open');
			btn.classList.toggle('is-on', open);
			btn.setAttribute('aria-expanded', String(open));
		});
	}
	setupFilterToggle('timeline-filter-btn', 'timeline-controls');
	setupFilterToggle('longest-filter-btn', 'longest-controls');

	setupSeg('metric-seg', (btn) => { metric = (btn.dataset.metric as typeof metric); syncSplitState(); renderTimeline(); playGrow(chartEl); });
	setupSeg('gran-seg', (btn) => { gran = (btn.dataset.gran as typeof gran); renderTimeline(); playGrow(chartEl); });
	setupSeg('split-seg', (btn) => { split = (btn.dataset.split as typeof split); renderTimeline(); playGrow(chartEl); });

	// ── Longest-books category toggle (All / Fiction / Non-fiction) ──
	// Swaps the chart-longest spec's data in place; renderStatic() re-renders it from the
	// same spec object on resize, so the selected category persists automatically.
	const longestEl = document.getElementById('stats-longest');
	const longestData: Record<string, { label: string; value: number }[]> =
		longestEl ? JSON.parse(longestEl.textContent || '{}') : {};
	const longestSpec = specs.find((sp) => sp.id === 'chart-longest');
	setupSeg('longest-seg', (btn) => {
		if (!longestSpec) return;
		const cat = btn.dataset.cat || 'all';
		const data = longestData[cat] || [];
		longestSpec.data = data;
		longestSpec.colors = data.map((_, i) => (i === 0 ? 'var(--ink)' : 'var(--viz-primary)'));
		const holder = document.getElementById('chart-longest');
		if (holder) { holder.innerHTML = renderSpec(longestSpec, widthOf(holder), isMobile()); playGrow(holder); }
	});

	// ── Genre / author metric toggles (Books ⇄ Pages) ──
	// Same in-place pattern as the longest-books toggle: swap the spec's data + value
	// formatter (and rank colours for the author chart), then re-render. renderStatic()
	// reuses the mutated spec on resize, so the choice persists.
	function setupMetricToggle(segId: string, chartId: string, jsonId: string, subId: string, prefix: string, rankColored: boolean) {
		const el = document.getElementById(jsonId);
		const byMetric: Record<string, { label: string; value: number }[]> =
			el ? JSON.parse(el.textContent || '{}') : {};
		const spec = specs.find((sp) => sp.id === chartId);
		const sub = document.getElementById(subId);
		setupSeg(segId, (btn) => {
			if (!spec) return;
			const m = btn.dataset.metric === 'pages' ? 'pages' : 'books';
			const data = byMetric[m] || [];
			spec.data = data;
			spec.value = m === 'pages' ? 'pp' : 'int';
			if (rankColored) spec.colors = data.map((_, i) => (i === 0 ? 'var(--ink)' : 'var(--viz-primary)'));
			spec.ariaLabel = `${prefix} by ${m} read`;
			const holder = document.getElementById(chartId);
			if (holder) { holder.innerHTML = renderSpec(spec, widthOf(holder), isMobile()); playGrow(holder); }
			if (sub) sub.textContent = `${prefix} by ${m} read`;
		});
	}
	setupMetricToggle('genres-metric-seg', 'chart-genres', 'stats-genre-metric', 'genres-sub', 'Top 15', false);
	setupMetricToggle('authors-metric-seg', 'chart-authors', 'stats-author-metric', 'authors-sub', 'Top 25', true);

	// Re-render everything on resize (debounced) so charts always fit their container.
	let raf = 0;
	window.addEventListener('resize', () => {
		clearTimeout(raf);
		raf = window.setTimeout(() => { renderStatic(); renderTimeline(); }, 150);
	});

	renderStatic();
	syncSplitState();
	renderTimeline();

	// ── Scroll-triggered count-up on the six headline cards ──────────────────────
	function setupCountUp() {
		const nums = Array.from(document.querySelectorAll<HTMLElement>('.stat-num[data-count]'));
		if (!nums.length || !motionOK) return; // no JS-motion → leave the SSR-final values
		const compactFmt = new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 });
		const fmtVal = (el: HTMLElement, n: number) =>
			el.dataset.fmt === 'compact' ? compactFmt.format(n) : Math.round(n).toLocaleString('en-US');
		const run = (el: HTMLElement) => {
			const target = Number(el.dataset.count || '0');
			const t0 = performance.now();
			const step = (now: number) => {
				const t = Math.min(1, (now - t0) / 900);
				const eased = t >= 1 ? 1 : 1 - Math.pow(2, -10 * t); // ease-out-expo
				el.textContent = fmtVal(el, target * eased);
				if (t < 1) requestAnimationFrame(step);
			};
			el.textContent = fmtVal(el, 0);
			requestAnimationFrame(step);
		};
		const io = new IntersectionObserver((entries) => {
			for (const e of entries) {
				if (!e.isIntersecting) continue;
				io.unobserve(e.target);
				run(e.target as HTMLElement);
			}
		}, { threshold: 0.4 });
		nums.forEach((el) => io.observe(el));
	}

	// ── Chart entrance: play the grow once each chart first scrolls into view ─────
	function setupChartEntrance() {
		if (!motionOK) return;
		const holders = Array.from(document.querySelectorAll<HTMLElement>(
			'.chart-holder, .rank-holder, .rating-holder, .split-holder'));
		const io = new IntersectionObserver((entries) => {
			for (const e of entries) {
				if (!e.isIntersecting) continue;
				io.unobserve(e.target);
				const el = e.target as HTMLElement;
				el.classList.remove('arm'); // drop the empty rest state, then play empty→fill
				playGrow(el);
			}
		}, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
		// Arm each chart empty up front — runs in the same task as the initial render, so the
		// first paint is already the empty state for below-fold charts (no filled-then-unfill).
		holders.forEach((el) => { el.classList.add('arm'); io.observe(el); });
	}

	// ── Scroll-spy: highlight the active section in the rail + chip strip ─────────
	function setupScrollSpy() {
		const sections = Array.from(document.querySelectorAll<HTMLElement>('.stats-section[id]'));
		const railLinks = new Map<string, HTMLElement>();
		document.querySelectorAll<HTMLElement>('[data-rail]').forEach((a) => railLinks.set(a.dataset.rail!, a));
		const chipLinks = new Map<string, HTMLElement>();
		document.querySelectorAll<HTMLElement>('[data-chip]').forEach((a) => chipLinks.set(a.dataset.chip!, a));
		const chipsTrack = document.querySelector<HTMLElement>('.chips-track');
		let current = '';
		const setActive = (id: string) => {
			if (id === current) return;
			current = id;
			railLinks.forEach((a, k) => a.classList.toggle('is-active', k === id));
			chipLinks.forEach((a, k) => {
				const on = k === id;
				a.classList.toggle('is-active', on);
				if (on && chipsTrack) {
					const left = a.offsetLeft - (chipsTrack.clientWidth - a.clientWidth) / 2;
					chipsTrack.scrollTo({ left: Math.max(0, left), behavior: motionOK ? 'smooth' : 'auto' });
				}
			});
		};
		const io = new IntersectionObserver((entries) => {
			const inBand = entries.filter((e) => e.isIntersecting)
				.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
			if (inBand[0]) setActive((inBand[0].target as HTMLElement).id);
		}, { rootMargin: '-15% 0px -75% 0px', threshold: 0 });
		sections.forEach((s) => io.observe(s));
	}

	// ── Scroll-progress bar under the header ─────────────────────────────────────
	function setupProgress() {
		const fill = document.querySelector<HTMLElement>('.scroll-progress span');
		if (!fill) return;
		let ticking = false;
		const update = () => {
			const h = document.documentElement;
			const max = h.scrollHeight - h.clientHeight;
			fill.style.transform = `scaleX(${max > 0 ? Math.min(1, h.scrollTop / max) : 0})`;
			ticking = false;
		};
		window.addEventListener('scroll', () => {
			if (!ticking) { ticking = true; requestAnimationFrame(update); }
		}, { passive: true });
		update();
	}

	// ── Smooth-scroll for rail + chip links (honours scroll-margin-top) ──────────
	function setupNavClicks() {
		document.querySelectorAll<HTMLAnchorElement>('[data-rail], [data-chip]').forEach((a) => {
			a.addEventListener('click', (e) => {
				const id = a.dataset.rail || a.dataset.chip;
				const target = id ? document.getElementById(id) : null;
				if (!target) return;
				e.preventDefault();
				target.scrollIntoView({ behavior: motionOK ? 'smooth' : 'auto', block: 'start' });
				history.replaceState(null, '', `#${id}`);
			});
		});
	}

	setupCountUp();
	setupChartEntrance();
	setupScrollSpy();
	setupProgress();
	setupNavClicks();
	// Re-align a deep-link target once the charts have sized themselves to their containers.
	if (location.hash) {
		const t = document.getElementById(location.hash.slice(1));
		if (t) requestAnimationFrame(() => t.scrollIntoView({ block: 'start' }));
	}

	// ── World map choropleth ────────────────────────────────────────────────────
	const countriesEl = document.getElementById('stats-countries');
	type CountryStat = { country: string; books: number; isoCode: string };
	const countryStats: CountryStat[] = countriesEl ? JSON.parse(countriesEl.textContent || '[]') : [];

	// Parse a CSS colour string (e.g. "#8B7355" or "rgb(139,115,85)") into [r,g,b].
	function parseColor(css: string): [number, number, number] {
		const tmp = document.createElement('div');
		tmp.style.color = css;
		document.body.appendChild(tmp);
		const c = getComputedStyle(tmp).color;
		document.body.removeChild(tmp);
		const m = c.match(/\d+/g) ?? ['200','196','190'];
		return [parseInt(m[0]), parseInt(m[1]), parseInt(m[2])];
	}

	async function renderWorldMap() {
		const container = document.getElementById('world-map');
		if (!container || countryStats.length === 0) return;

		const res = await fetch('/world-map.svg').catch(() => null);
		if (!res?.ok) return;
		const svgText = await res.text();

		// Inject SVG inline so we can style individual paths.
		const loading = container.querySelector('.world-map-loading');
		if (loading) loading.remove();
		container.insertAdjacentHTML('beforeend', svgText);
		const svg = container.querySelector('svg');
		if (!svg) return;
		svg.setAttribute('width', '100%');
		svg.removeAttribute('height');
		svg.style.display = 'block';

		// Resolve palette colours from CSS vars before touching paths.
		const cs = getComputedStyle(container);
		const landFill = cs.getPropertyValue('--map-land').trim() || '#e4ddd1';
		const borderFill = cs.getPropertyValue('--map-border').trim() || 'rgba(22,19,16,0.15)';

		// Set default fill/stroke on every path now (no embedded <style> in the SVG).
		for (const p of svg.querySelectorAll('path')) {
			p.setAttribute('fill', landFill);
			p.setAttribute('stroke', borderFill);
			p.setAttribute('stroke-width', '0.5');
		}

		// Build isoCode → books map.
		const byIso = new Map<string, number>(countryStats.map((c) => [c.isoCode, c.books]));

		// Stepped choropleth: discrete rust opacity buckets by book count.
		const [r, g, b] = parseColor(cs.getPropertyValue('--map-accent').trim() || '#9c4a2a');
		const bucketFill = (books: number): string =>
			books >= 16 ? `rgb(${r},${g},${b})`
			: books >= 9 ? `rgba(${r},${g},${b},0.70)`
			: books >= 4 ? `rgba(${r},${g},${b},0.40)`
			: `rgba(${r},${g},${b},0.15)`; // 1–3

		for (const [iso, books] of byIso) {
			if (!iso) continue;
			const el = svg.getElementById(iso) as SVGPathElement | null;
			if (!el) continue;
			el.style.fill = bucketFill(books);
		}
	}

	renderWorldMap();
});
</script>
