---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import PageMasthead from '../../components/PageMasthead.astro';
import EditorialCell from '../../components/EditorialCell.astro';
import { getCollection } from 'astro:content';
import { getBlogUrl } from '../../utils/blog';

const allPosts = (await getCollection('blog', ({ data }) => data.status === 'live'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const posts = allPosts.filter(p => p.data.postType === 'list');

const featuredLists = posts.slice(0, 6);  // editorial cells
const moreLists     = posts.slice(6);     // "more lists" table

// Per-position cell styling, echoing the homepage §05–08 cells.
const CELL_STYLES = [
	{ color: 'green', cols: 4, max: 4, caps: false },
	{ color: 'cream', cols: 5, max: 5, caps: true  },
	{ color: 'rust',  cols: 4, max: 4, caps: false },
	{ color: 'dark',  cols: 3, max: 3, caps: false },
	{ color: 'slate', cols: 4, max: 4, caps: false },
	{ color: 'plum',  cols: 4, max: 4, caps: false },
] as const;

const cover = (url?: string | null) => (url && url !== 'TK' ? url : null);
const mapPicks = (post: (typeof posts)[number]) =>
	(post.data.picks ?? []).map((p) => ({ title: p.bookTitle, author: p.author ?? null, cover: cover(p.cover) }));
const monthYear = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Curated Lists — Saturdays in a Book" description="Ranked and curated reading lists from my shelves." ogImage="/og/default.png" />
	</head>
	<body>
		<Header />
		<main>
			<PageMasthead eyebrow="All Lists" title="Curated reading lists." />

			{featuredLists.length > 0 && (
				<div class="cells-band">
					{featuredLists.map((post, i) => {
						const s = CELL_STYLES[i % CELL_STYLES.length];
						return (
							<EditorialCell
								href={getBlogUrl(post.id)}
								title={post.data.title}
								blurb={post.data.description}
								num={String(i + 1).padStart(2, '0')}
								color={s.color}
								picks={mapPicks(post)}
								cols={s.cols}
								maxPicks={s.max}
								captions={s.caps}
								count={(post.data.picks ?? []).length}
								footRight={monthYear(post.data.pubDate)}
							/>
						);
					})}
				</div>
			)}

			{moreLists.length > 0 && (
				<div class="bleed lists-more">
					<div class="lists-more-heading">More lists</div>
					<div class="lists-table">
						{moreLists.map((post, i) => (
							<a href={getBlogUrl(post.id)} class="lt-row">
								<span class="lt-num">List {String(i + featuredLists.length + 1).padStart(2, '0')}</span>
								<div class="lt-content">
									<span class="lt-title">{post.data.title}</span>
									{post.data.description && <span class="lt-blurb">{post.data.description}</span>}
								</div>
								<span class="lt-date"><FormattedDate date={post.data.pubDate} /></span>
								<span class="lt-arrow-row">→</span>
							</a>
						))}
					</div>
				</div>
			)}

			{posts.length === 0 && (
				<div class="bleed"><div class="empty">No lists yet — check back soon.</div></div>
			)}
		</main>
		<Footer />

		<button class="back-to-top" id="back-to-top" aria-label="Back to top">
			<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
				<path d="M7 11.5V2.5"/><path d="M3 6.5l4-4 4 4"/>
			</svg>
		</button>
	</body>
</html>

<style>
main { padding-bottom: clamp(48px, 6vw, 88px); }
.lists-more { margin-top: clamp(40px, 5vw, 72px); }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
	const btn = document.getElementById('back-to-top');
	if (btn) {
		window.addEventListener('scroll', () => btn.classList.toggle('is-visible', window.scrollY > 600), { passive: true });
		btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
	}
});
</script>
