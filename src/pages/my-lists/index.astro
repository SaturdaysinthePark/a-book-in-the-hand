---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageMasthead from '../../components/PageMasthead.astro';
import EditorialCell from '../../components/EditorialCell.astro';
import { getCollection } from 'astro:content';
import { getBlogUrl } from '../../utils/blog';

const allPosts = (await getCollection('blog', ({ data }) => data.status === 'live'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const posts = allPosts.filter(p => p.data.postType === 'list');

// Tier assignment is positional (design_handoff_lists_page): newest = hero,
// next two = half blocks, everything from the fourth list on = band rows.
const hero = posts[0] ?? null;
const halves = posts.slice(1, 3);
const bandLists = posts.slice(3);
const lastBand = bandLists.length > 0 ? bandLists[bandLists.length - 1] : null;
const extraBandLists = bandLists.slice(0, -1);

const cover = (url?: string | null) => (url && url !== 'TK' ? url : null);
const mapPicks = (post: (typeof posts)[number]) =>
	(post.data.picks ?? []).map((p) => ({ title: p.bookTitle, author: p.author ?? null, cover: cover(p.cover) }));
const monthYear = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' }).toUpperCase();
const countLabel = (post: (typeof posts)[number]) => `${(post.data.picks ?? []).length} books`.toUpperCase();
const heroMeta = hero ? `Latest · ${monthYear(hero.data.pubDate)} · ${countLabel(hero)}`.toUpperCase() : '';
const meta = (post: (typeof posts)[number]) => `${monthYear(post.data.pubDate)} · ${countLabel(post)}`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Curated Lists — Saturdays in a Book" description="Ranked and curated reading lists from my shelves." ogImage="/og/default.png" />
	</head>
	<body>
		<Header />
		<main>
			<PageMasthead eyebrow="All Lists" title="Curated reading lists." />

			<div class="lists-tiers">
				{hero && (
					<div class="cells-band">
						<EditorialCell
							href={getBlogUrl(hero.id)}
							title={hero.data.title}
							blurb={hero.data.description}
							num="01"
							tier="hero"
							color="green"
							meta={heroMeta}
							picks={mapPicks(hero)}
							maxShown={5}
							mobileMaxShown={3}
						/>
					</div>
				)}

				{halves.length > 0 && (
					<div class:list={['cells-row--half', halves.length === 1 && 'is-solo']}>
						{halves.map((post, i) => (
							<EditorialCell
								href={getBlogUrl(post.id)}
								title={post.data.title}
								blurb={post.data.description}
								num={String(i + 2).padStart(2, '0')}
								tier="half"
								color={i === 0 ? 'rust' : 'brown'}
								meta={meta(post)}
								picks={mapPicks(post)}
								maxShown={5}
								mobileMaxShown={4}
							/>
						))}
					</div>
				)}

				{extraBandLists.map((post, i) => (
					<div class="cells-row--band is-solo">
						<EditorialCell
							href={getBlogUrl(post.id)}
							title={post.data.title}
							num={String(i + 4).padStart(2, '0')}
							tier="band"
							color={i % 2 === 0 ? 'paper2' : 'paper'}
							meta={meta(post)}
							picks={mapPicks(post)}
						/>
					</div>
				))}

				<div class:list={['cells-row--band', !lastBand && 'is-solo']}>
					{lastBand && (
						<EditorialCell
							href={getBlogUrl(lastBand.id)}
							title={lastBand.data.title}
							num={String(3 + bandLists.length).padStart(2, '0')}
							tier="band"
							color={extraBandLists.length % 2 === 0 ? 'paper2' : 'paper'}
							meta={meta(lastBand)}
							picks={mapPicks(lastBand)}
						/>
					)}
					<div class="ed-cell ed-cell--empty">
						<span class="wm-num" aria-hidden="true">{String(4 + bandLists.length).padStart(2, '0')}</span>
						<div class="ed-cell--empty__box">
							<p class="ed-cell--empty__eyebrow">§ Next list</p>
							<h2>More to come.</h2>
							<p class="ed-cell__blurb">New lists and recommendations to land soon.</p>
						</div>
					</div>
				</div>
			</div>

			{posts.length === 0 && (
				<div class="bleed"><div class="empty">No lists yet — check back soon.</div></div>
			)}
		</main>
		<Footer />

		<button class="back-to-top" id="back-to-top" aria-label="Back to top">
			<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
				<path d="M7 11.5V2.5"/><path d="M3 6.5l4-4 4 4"/>
			</svg>
		</button>
	</body>
</html>

<style>
.lists-tiers { border-bottom: 3px solid var(--ink); }
.cells-row--half.is-solo,
.cells-row--band.is-solo { grid-template-columns: 1fr; }
.cells-row--half.is-solo > :first-child,
.cells-row--band.is-solo > :first-child { border-right: 0; }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
	const btn = document.getElementById('back-to-top');
	if (btn) {
		window.addEventListener('scroll', () => btn.classList.toggle('is-visible', window.scrollY > 600), { passive: true });
		btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
	}
});
</script>
