---
import { getCollection } from 'astro:content';

// Author "pages" now live as a filtered view of the shelf (mirrors genre
// browsing). We keep the old /authors/<slug>/ URLs alive as redirect stubs so
// existing in-content links and any indexed/backlinked URLs forward to the
// filtered shelf instead of 404-ing.
export async function getStaticPaths() {
	const allPosts = await getCollection('blog');
	const allAuthors = new Set<string>();

	// Only include book authors who have live reviews (lists live in /my-lists).
	allPosts.forEach(post => {
		if (post.data.author && post.data.status === 'live' && post.data.postType !== 'list') {
			allAuthors.add(post.data.author.toLowerCase().replace(/\s+/g, '-'));
		}
	});

	return Array.from(allAuthors).map(author => ({
		params: { author },
		props: { author },
	}));
}

const { author } = Astro.props;
const allPosts = await getCollection('blog');

// Recover the author's display name (proper casing) from a matching live review,
// so the shelf filter receives the exact name string.
const match = allPosts.find(post =>
	post.data.author &&
	post.data.author.toLowerCase().replace(/\s+/g, '-') === author &&
	post.data.status === 'live' &&
	post.data.postType !== 'list'
);
const originalAuthor = match?.data.author || author.replace(/-/g, ' ');

const target = `/book-reviews?author=${encodeURIComponent(originalAuthor)}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="refresh" content={`0;url=${target}`} />
		<link rel="canonical" href={target} />
		<title>Books by {originalAuthor} — Saturdays in a Book</title>
	</head>
	<body>
		<p>Redirecting to <a href={target}>books by {originalAuthor}</a>…</p>
	</body>
</html>
