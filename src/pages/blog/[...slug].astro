---
import { type CollectionEntry, getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { render } from 'astro:content';
import { tagsForPost } from '../../utils/blog';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => data.status === 'live');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);

// For review posts with a shelf entry, use shelf subgenres as tags.
// Non-review posts (lists, discussions) keep their frontmatter tags.
const tags = tagsForPost(post, new Set());
---

<BlogPost {...post.data} tags={tags}>
	<Content />
</BlogPost>
