---
import { type CollectionEntry, getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { render } from 'astro:content';
import { subgenresForPost } from '../../utils/blog';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => data.status === 'live');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);

// Sidebar genre links use the book's shelf subgenres ([] for posts with no shelf
// entry, e.g. non-review posts or off-shelf editions).
const genres = subgenresForPost(post);

const ogImage = post.data.postType === 'review' ? `/og/reviews/${post.id}.png`
	: post.data.postType === 'list' ? `/og/lists/${post.id}.png`
	: undefined;
---

<BlogPost {...post.data} genres={genres} ogImage={ogImage} body={post.body} postId={post.id}>
	{post.data.postType !== 'list' && <Content />}
</BlogPost>
