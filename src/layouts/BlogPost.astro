---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { filterDisplayTags } from '../utils/blog';
import BookCover from '../components/BookCover.astro';

type Props = CollectionEntry<'blog'>['data'];

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	bookTitle,
	author,
	genre,
	rating,
	purchaseLink,
	tags,
	postType = 'review',
	picks,
	publishYear
} = Astro.props;

const authorSlug    = author ? author.toLowerCase().replace(/\s+/g, '-') : '';
const authorSlugs   = new Set(authorSlug ? [authorSlug] : []);
const displayTags   = tags ? filterDisplayTags(tags, authorSlugs) : [];

// Resolve pick covers from linked review posts when cover is absent
let resolvedPicks = picks;
if (picks?.length) {
	const allEntries = await getCollection('blog');
	const heroBySlug = new Map(allEntries.map(e => [e.id, e.data.heroImage]));
	resolvedPicks = picks.map(pick => {
		if (pick.cover && pick.cover !== 'TK') return pick;
		if (!pick.reviewUrl) return pick;
		// reviewUrl: "/blog/2025/02/25/taiwan-travelogue/" → slug: "2025/02/25/taiwan-travelogue"
		const slug = decodeURIComponent(pick.reviewUrl.replace(/^\/blog\//, '').replace(/\/$/, ''));
		const hero = heroBySlug.get(slug);
		return hero ? { ...pick, cover: hero } : pick;
	});
}

// Deterministic cover color for books without photos

const pageTitle = postType === 'review' && bookTitle && author
	? `${bookTitle} by ${author} — Saturdays in a Book`
	: `${title} — Saturdays in a Book`;
const pageDesc = postType === 'review' && rating
	? `${description} Rating: ${rating}/5 stars.`
	: description;

// Star rendering helper
function stars(n: number) {
	return Array.from({ length: 5 }, (_, i) => i < n ? '★' : '☆').join('');
}
---

<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDesc} type="article" />

		{postType === 'review' && bookTitle && author && rating && (
			<script type="application/ld+json">
				{JSON.stringify({
					"@context": "https://schema.org",
					"@type": "Review",
					"itemReviewed": { "@type": "Book", "name": bookTitle, "author": { "@type": "Person", "name": author }, "image": heroImage },
					"reviewRating": { "@type": "Rating", "ratingValue": rating, "bestRating": 5, "worstRating": 1 },
					"author": { "@type": "Person", "name": "Sabtain Khan" },
					"datePublished": pubDate.toISOString().split('T')[0],
					"description": description,
					"url": Astro.url.href
				})}
			</script>
		)}
	</head>

	<body>
		{postType === 'review' && <div class="reading-progress" id="reading-progress"></div>}
		<Header />

		<main>
			{postType === 'review' ? (
				<!-- ── Review post layout ── -->
				<div class="review-page">
					<div class="shell">
						<p class="crumbs">
							§ <a href="/book-reviews">Review</a> · <FormattedDate date={pubDate} />
						</p>
						<div class="review-grid">
							<!-- Sidebar -->
							<aside class="side">
								<BookCover title={bookTitle || title} author={author} cover={heroImage} loading="eager" />
								{bookTitle && <h2>{bookTitle}</h2>}
								{author && (
									<p class="by">
										by <a href={`/authors/${authorSlug}/`}>{author}</a>
									</p>
								)}
								{rating && (
									<span class="rating" aria-label={`${rating} out of 5`}>
										{Array.from({ length: 5 }, (_, i) => (
											<svg class="star" viewBox="0 0 16 16" fill={i < rating ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.2">
												<path d="M8 1.5l2 4.5 4.8.4-3.6 3.2 1.1 4.8L8 11.9 3.7 14.4l1.1-4.8L1.2 6.4 6 6z" stroke-linejoin="round" stroke-linecap="round"/>
											</svg>
										))}
									</span>
								)}
								<div class="meta-list">
									{publishYear && <div><span>Published</span><strong>{publishYear}</strong></div>}
									{genre && <div><span>Genre</span><strong>{genre}</strong></div>}
									{displayTags.length > 0 && (
										<div><span>Tags</span><strong>{displayTags.slice(0, 3).join(', ')}</strong></div>
									)}
								</div>
							</aside>

							<!-- Article -->
							<article>
								<h1>{title}</h1>
								<slot />
							</article>
						</div>
					</div>
				</div>
			) : (
				<!-- ── List post layout ── -->
				<div class="list-post">
					<div class="shell">
						<div class="lp-hero">
							<p class="crumbs">
								§ <a href="/my-lists">All Lists</a> · Published <FormattedDate date={pubDate} />
							</p>
							<h1>{title}</h1>
							{description && <p>{description}</p>}
							{updatedDate && <p class="lp-meta">Updated <FormattedDate date={updatedDate} /></p>}
						</div>

						{resolvedPicks && resolvedPicks.length > 0 && (
							<div class="lp-entries">
								{resolvedPicks.map((pick, i) => {
									return (
										<article class="lp-entry">
											<div class="lp-num">{String(i + 1).padStart(2, '0')}</div>
											<div class="lp-title-mobile"><h3>{pick.bookTitle}</h3></div>
											<div class="lp-cover">
												{pick.reviewUrl ? (
													<a href={pick.reviewUrl}>
														<BookCover title={pick.bookTitle} author={pick.author} cover={pick.cover} />
													</a>
												) : (
													<BookCover title={pick.bookTitle} author={pick.author} cover={pick.cover} />
												)}
											</div>
											<div class="lp-body">
												<h3 class="lp-title-desktop">{pick.bookTitle}</h3>
												{pick.author && (
													<div class="lp-author">
														{pick.author}
														{pick.rating && <> · {stars(pick.rating)}</>}
													</div>
												)}
												{pick.blurb && <p>{pick.blurb}</p>}
												{pick.pull && <p class="lp-pull">"{pick.pull}"</p>}
												{pick.reviewUrl && <a class="lp-read" href={pick.reviewUrl}>Read the full review →</a>}
											</div>
										</article>
									);
								})}
							</div>
						)}

						<div class="list-prose">
							<slot />
						</div>
					</div>
				</div>
			)}
		</main>

		<Footer />

		<button class="back-to-top" id="back-to-top" aria-label="Back to top">
			<svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
				<path d="M7 11.5V2.5"/>
				<path d="M3 6.5l4-4 4 4"/>
			</svg>
		</button>
	</body>
</html>

<script>
document.addEventListener('DOMContentLoaded', () => {
	// Back to top
	const btn = document.getElementById('back-to-top');
	if (btn) {
		window.addEventListener('scroll', () => {
			btn.classList.toggle('is-visible', window.scrollY > 600);
		}, { passive: true });
		btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
	}

	// Reading progress bar
	const bar = document.getElementById('reading-progress');
	if (bar) {
		window.addEventListener('scroll', () => {
			const scrollTop = window.scrollY;
			const docHeight = document.documentElement.scrollHeight - window.innerHeight;
			const progress  = docHeight > 0 ? scrollTop / docHeight : 0;
			(bar as HTMLElement).style.transform = `scaleX(${progress})`;
		}, { passive: true });
	}
});
</script>
